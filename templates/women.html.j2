<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ og_title or ('Ipswich Town Women · ' + season) }}</title>
<meta name="description" content="{{ og_description or 'Ipswich Town Women WSL2 stats.' }}">
{% if canonical %}<link rel="canonical" href="{{ canonical }}">{% endif %}
<meta property="og:type" content="website">
<meta property="og:title" content="{{ og_title or 'Ipswich Town Women' }}">
<meta property="og:description" content="{{ og_description or '' }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title or 'Ipswich Town Women' }}">
<meta name="twitter:description" content="{{ og_description or '' }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ css_href }}">
{% if ga_id %}
<script async src="https://www.googletagmanager.com/gtag/js?id={{ ga_id }}"></script>
<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','{{ ga_id }}');</script>
{% endif %}
<script>
(function(){var K='itfc-theme',d=document.documentElement;
 try{if(sessionStorage.getItem('itfc-seen')){d.classList.add('seen');}else{sessionStorage.setItem('itfc-seen','1');}}catch(e){}
 function set(t){d.setAttribute('data-theme',t);}
 try{set(localStorage.getItem(K)||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'));}catch(e){set('light');}
 window.__setTheme=function(t){set(t);try{localStorage.setItem(K,t);}catch(e){}location.reload();};
})();
</script>
</head>
<body class="page-{{ page }}">
<a class="skiplink" href="#main">Skip to content</a>
{% include '_toggle.html.j2' %}
<header class="masthead">
  <div class="wrap">
    <div class="crest">
      <div>
        <div class="eyebrow">{{ league_name }} · {{ season }}{% if position %} <span class="pos">{{ position|ordinal }}</span>{% endif %}</div>
        <div class="wordmark">Ipswich Town Women</div>
      </div>
    </div>
    <div class="headright">
      <div class="themeswitch" role="group" aria-label="Theme">
        <button type="button" class="opt" data-theme-opt="light" onclick="__setTheme('light')">Light</button>
        <button type="button" class="opt" data-theme-opt="dark" onclick="__setTheme('dark')">Dark</button>
        <button type="button" class="opt" data-theme-opt="teletext" onclick="__setTheme('teletext')">Txt</button>
      </div>
      <div class="updated">Updated<b>{{ generated_at|updated }}</b></div>
    </div>
  </div>
</header>
<script>(function(){var t=document.documentElement.getAttribute('data-theme');
  document.querySelectorAll('.themeswitch .opt').forEach(function(b){
    b.setAttribute('aria-pressed', b.dataset.themeOpt===t ? 'true' : 'false');});})();</script>
<nav class="tabs">
  <div class="wrap">
    {% for pid, filename, label in pages %}
    <a href="{{ filename }}"{% if pid == current %} class="active" aria-current="page"{% endif %}>{{ label }}</a>
    {% endfor %}
  </div>
</nav>

<main class="wrap" id="main" tabindex="-1">

  <!-- OVERVIEW -->
  {% if page == 'overview' %}
  <section class="panel">
    {% if summary_text %}
    <div class="block">
      <div class="snapshot">
        <div class="cardhead">
          <div class="snapshot-label">Season snapshot</div>
        </div>
        <p>{{ summary_text }}</p>
      </div>
    </div>
    {% endif %}
    {% if form_guide %}
    <div class="block">
      <div class="formguide">
        <div class="fg-head">
          <div class="hgroup">
            <span class="fg-label">Form guide · last {{ form_guide.count }}</span>
          </div>
          <span class="fg-summary">{{ form_guide.pts }} pts · {{ '%.2f'|format(form_guide.ppg) }} PPG
            <span class="fg-trend {{ form_guide.trend }}" title="Momentum {{ form_guide.trend }}">{{ {'up':'▲','down':'▼','flat':'▬'}[form_guide.trend] }}</span></span>
        </div>
        <div class="fg-tiles">
          {% for m in form_guide.matches %}
          <div class="fg-tile">
            <div class="fg-tile-top">
              <span class="res {{ m.result }}">{{ m.result }}</span>
              <span class="fg-tile-opp">{{ m.opponent_short or m.opponent }}</span>
            </div>
            <div class="fg-tile-meta">{{ 'H' if m.home else 'A' }}{% if m.event %} · MD{{ m.event }}{% endif %}</div>
            <div class="fg-tile-score">{{ m.score }}</div>
            <div class="fg-tile-rows">
              <div><span class="k">Pts</span><span class="v">{{ m.pts }}</span></div>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
    {% endif %}

    <div class="block card">
      <div class="cardhead"><h3>Next fixture</h3></div>
      {% if next_fixture %}
      <div class="board">
        <div class="row">
          <div class="side">{% if team.badge %}<img class="badge-lg" src="{{ team.badge }}" alt="">{% endif %}<div class="abbr">{{ team.short_name }}</div><div class="full">Ipswich Town</div></div>
          <div class="vs">{{ "HOME" if next_fixture.home else "AWAY" }}</div>
          <div class="side">{% if next_fixture.badge %}<img class="badge-lg" src="{{ next_fixture.badge }}" alt="">{% endif %}<div class="abbr">{{ next_fixture.opponent_short }}</div><div class="full">{{ next_fixture.opponent }}</div></div>
        </div>
        <div class="when">{{ next_fixture.kickoff|kickoff }}{% if next_fixture.event %} · Matchday {{ next_fixture.event }}{% endif %}</div>
      </div>
      {% else %}<div class="board empty"><div class="row">No upcoming fixtures scheduled yet.</div></div>{% endif %}
    </div>

    <div class="block card">
      <div class="cardhead"><h3>Season record</h3></div>
      <div class="stats">
        <div class="stat accent"><div class="v">{{ summary.points }}</div><div class="k">Points</div></div>
        <div class="stat"><div class="v">{{ summary.played }}</div><div class="k">Played</div></div>
        <div class="stat"><div class="v">{{ summary.won }}</div><div class="k">Won</div></div>
        <div class="stat"><div class="v">{{ summary.drawn }}</div><div class="k">Drawn</div></div>
        <div class="stat"><div class="v">{{ summary.lost }}</div><div class="k">Lost</div></div>
        <div class="stat"><div class="v">{{ summary.gf }}</div><div class="k">For</div></div>
        <div class="stat"><div class="v">{{ summary.ga }}</div><div class="k">Against</div></div>
        <div class="stat"><div class="v {{ 'pos' if summary.gd>0 else 'neg' if summary.gd<0 else '' }}">{{ '%+d'|format(summary.gd) if summary.gd else 0 }}</div><div class="k">Goal diff</div></div>
      </div>
    </div>

    {% if venue or coach %}
    <div class="block card">
      <div class="cardhead"><h3>Club info</h3></div>
      <div class="stats">
        {% if venue %}
        <div class="stat"><div class="v" style="font-size:16px">{{ venue.name }}</div><div class="k">Stadium{% if venue.city %} · {{ venue.city }}{% endif %}</div></div>
        {% if venue.capacity %}<div class="stat"><div class="v">{{ '{:,}'.format(venue.capacity) }}</div><div class="k">Capacity</div></div>{% endif %}
        {% if venue.opened %}<div class="stat"><div class="v">{{ venue.opened }}</div><div class="k">Opened</div></div>{% endif %}
        {% endif %}
        {% if coach %}
        <div class="stat"><div class="v" style="font-size:16px">{{ coach.name }}</div><div class="k">Head coach{% if coach.nationality %} · {{ coach.nationality }}{% endif %}</div></div>
        {% if coach.win is not none %}<div class="stat"><div class="v">{{ coach.win }}-{{ coach.draw }}-{{ coach.loss }}</div><div class="k">W-D-L this season</div></div>{% endif %}
        {% if coach.points_per_game is not none %}<div class="stat"><div class="v">{{ coach.points_per_game }}</div><div class="k">Points/game</div></div>{% endif %}
        {% endif %}
      </div>
    </div>
    {% endif %}

    {% if news %}
    <div class="block card">
      <div class="cardhead"><h3>Latest news</h3></div>
      <ul class="list newslist">
        {% for a in news[:5] %}
        <li>
          {% if a.image %}<img class="thumb" src="{{ a.image|e }}" alt="" loading="lazy">{% endif %}
          <div class="body">
            <div class="meta"><span class="src">{{ a.source|e }}</span>{% if a.date_display %}<span class="date">{{ a.date_display|e }}</span>{% endif %}</div>
            <a class="headline" href="{{ a.link|e }}" target="_blank" rel="noopener noreferrer">{{ a.title|e }}</a>
          </div>
        </li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}
  </section>
  {% endif %}

  <!-- TABLE -->
  {% if page == 'table' %}
  <section class="panel">
    <div class="block card">
    <div class="cardhead"><h3>{{ league_name }} table</h3></div>
    {% if table %}
    <div class="tablewrap">
      <table class="ltable">
        <thead><tr>
          <th class="rk">#</th><th class="tm">Team</th>
          <th>P</th><th>W</th><th>D</th><th>L</th><th>GF</th><th>GA</th><th>GD</th><th>Pts</th><th class="formcol">Form</th>
        </tr></thead>
        <tbody>
          {% for row in table %}
          <tr class="{{ 'ips ' if row.is_ipswich }}">
            <td class="rk">{{ row.rank }}</td>
            <td class="tm">{% if row.badge %}<img class="badge" src="{{ row.badge }}" alt="">{% endif %}{{ row.team }}</td>
            <td>{{ row.played }}</td><td>{{ row.won }}</td><td>{{ row.drawn }}</td><td>{{ row.lost }}</td>
            <td>{{ row.gf }}</td><td>{{ row.ga }}</td><td>{{ '%+d'|format(row.gd) if row.gd else 0 }}</td>
            <td><b>{{ row.points }}</b></td>
            <td class="formcol">{% for r in row.form %}<span class="fdot {{ r }}" title="{{ r }}"></span>{% endfor %}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <div class="lkey">
      <span><i style="background:var(--tint-sky);border:1px solid var(--hairline)"></i> Ipswich</span>
    </div>
    {% else %}<p class="empty-note">League table unavailable right now. It will appear on the next successful update.</p>{% endif %}
    </div>
  </section>
  {% endif %}

  <!-- MATCHES -->
  {% if page == 'matches' %}
  <section class="panel">
    {% if last_match %}
    {% macro women_lineup_row(p) %}
      <li>
        <span class="min">{{ p.shirt or '' }}</span>
        <span class="eventtext">{{ p.name }}{% if p.is_captain %} (C){% endif %}{% if p.player_of_match %} ★{% endif %}
          {% for c in p.cards|default([]) %}<span class="cardchip {{ c.kind }}" title="{{ c.minute }}"></span>{% endfor %}
          {% if p.goals %}<span class="assist">G {{ p.goals|join(', ') }}</span>{% endif %}
          {% if p.assists %}<span class="assist">A {{ p.assists|join(', ') }}</span>{% endif %}
          {% if p.sub_off %}<span class="assist">↓ {{ p.sub_off }}</span>{% endif %}
          {% if p.sub_on %}<span class="assist">↑ {{ p.sub_on }}</span>{% endif %}
        </span>
        <span class="assist">{% if p.rating %}{{ '%.1f'|format(p.rating) }}{% endif %}</span>
      </li>
    {% endmacro %}
    {% macro women_pitch_marker(p) %}
      {% if p.x is not none and p.y is not none %}
      {% set cx = (p.x * 598 + 1)|round(1) %}{% set cy = (p.y * 398 + 1)|round(1) %}
      <g>
        <circle cx="{{ cx }}" cy="{{ cy }}" r="13" fill="var(--primary)" stroke="var(--canvas)" stroke-width="2"/>
        <text x="{{ cx }}" y="{{ cy }}" text-anchor="middle" dominant-baseline="central" font-size="10" font-weight="700" fill="#fff">{{ p.shirt or '' }}</text>
        <text x="{{ cx }}" y="{{ cy + 22 }}" text-anchor="middle" font-size="9" fill="var(--ink)">{{ p.name }}</text>
        <title>{{ p.full_name }}{% if p.rating %} · {{ '%.1f'|format(p.rating) }}{% endif %}</title>
      </g>
      {% endif %}
    {% endmacro %}
    <div class="block card">
      <div class="cardhead"><h3>Last match{% if last_match.score %}: {{ last_match.score }} v {{ last_match.opponent }}{% else %} v {{ last_match.opponent }}{% endif %}</h3><button class="infobtn" type="button" aria-label="About this data"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Starting XI, ratings and events from the most recent match — FotMob only carries this level of detail for the latest matchday, not the full archive. Source: FotMob.</span></button></div>
      <div class="meta">
        {% if last_match.result %}<span class="pill {{ last_match.result }}">{{ {'W':'Win','D':'Draw','L':'Loss'}[last_match.result] }}</span>{% endif %}
        &nbsp; {{ 'Home' if last_match.home else 'Away' }}
        {% if last_match.date %} · {{ last_match.date }}{% endif %}
        {% if last_match.formation %} · {{ last_match.formation }}{% endif %}
        {% if last_match.team_rating %} · Team rating {{ '%.1f'|format(last_match.team_rating) }}{% endif %}
        {% if last_match.average_age %} · Avg age {{ '%.1f'|format(last_match.average_age) }}{% endif %}
        {% if last_match.coach_name %} · Coach: {{ last_match.coach_name }}{% endif %}
      </div>
      <div class="pitch-holder">
        <svg role="img" aria-label="Starting lineup on a pitch" class="pitch" viewBox="0 0 600 400" xmlns="http://www.w3.org/2000/svg">
          <rect x="1" y="1" width="598" height="398" fill="var(--tint-mint)" stroke="var(--hairline-strong)"/>
          <line x1="300" y1="1" x2="300" y2="399" stroke="var(--hairline-strong)"/>
          <circle cx="300" cy="200" r="40" fill="none" stroke="var(--hairline-strong)"/>
          <rect x="1" y="110" width="80" height="180" fill="none" stroke="var(--hairline-strong)"/>
          <rect x="519" y="110" width="80" height="180" fill="none" stroke="var(--hairline-strong)"/>
          {% for p in last_match.starters %}{{ women_pitch_marker(p) }}{% endfor %}
        </svg>
      </div>
      <ul class="plain">
        {% for p in last_match.starters %}{{ women_lineup_row(p) }}{% endfor %}
      </ul>
      {% if last_match.subs %}
      <p class="empty-note" style="padding-top:0">Substitutes:</p>
      <ul class="plain">
        {% for p in last_match.subs %}{{ women_lineup_row(p) }}{% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endif %}
    <div class="block card">
    <div class="cardhead"><h3>Results &amp; fixtures</h3></div>
    {% if results %}
    <div class="tablewrap">
      <table class="ltable">
        <thead><tr><th>Date</th><th class="tm">Opponent</th><th>Result</th><th>Score</th></tr></thead>
        <tbody>
          {% for m in results %}
          <tr>
            <td>{{ m.date }}</td>
            <td class="tm">{% if m.opponent_badge %}<img class="badge" src="{{ m.opponent_badge }}" alt="">{% endif %}{{ m.opponent }} <span class="ha">{{ '(H)' if m.home else '(A)' }}</span></td>
            <td><span class="res {{ m.result }}">{{ m.result }}</span></td>
            <td><b>{{ m.score }}</b></td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}<p class="empty-note">No matches played yet.</p>{% endif %}
    </div>
    {% if upcoming %}
    <div class="block card" style="margin-top:30px">
    <div class="cardhead"><h3>Upcoming</h3></div>
    <div class="tablewrap">
      <table class="ltable">
        <thead><tr><th>Date</th><th class="tm">Opponent</th><th>Venue</th></tr></thead>
        <tbody>
          {% for m in upcoming %}
          <tr>
            <td>{{ m.kickoff|kickoff }}</td>
            <td class="tm">{{ m.opponent }}</td>
            <td>{{ 'Home' if m.home else 'Away' }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    </div>
    {% endif %}
  </section>
  {% endif %}

  <!-- CHARTS -->
  {% if page == 'charts' %}
  <section class="panel">
    <div class="chartgrid">
      <div class="chartcard wide">
        <div class="cardhead"><div class="htitle"><h3>Points progression</h3><p class="sub">Points so far (solid), projected to the end of the season (dashed) at the club's current rate.</p></div><button class="infobtn" type="button" aria-label="About this chart"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Cumulative points from full-time results, projected to the end of the season at the club's current points-per-game. Source: FotMob.</span></button></div>
        <div class="canvas-holder"><canvas id="c-wpoints"></canvas></div><div class="note" id="n-wpoints" hidden></div>
      </div>
      <div class="chartcard wide">
        <div class="cardhead"><div class="htitle"><h3>Goals by match</h3><p class="sub">Goals scored and conceded in each match: a quick read of the club's best and worst weeks.</p></div><button class="infobtn" type="button" aria-label="About this chart"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Goals scored and conceded, match by match. Source: FotMob.</span></button></div>
        <div class="canvas-holder"><canvas id="c-wgoals"></canvas></div><div class="note" id="n-wgoals" hidden></div>
      </div>
      <div class="chartcard wide">
        <div class="cardhead"><div class="htitle"><h3>Home &amp; away split</h3><p class="sub">Per-game points and goals at home vs away: how differently the side performs by venue.</p></div><button class="infobtn" type="button" aria-label="About this chart"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Points and goals per game, split by venue. Source: FotMob match results.</span></button></div>
        <div class="canvas-holder"><canvas id="c-whomeaway"></canvas></div><div class="note" id="n-whomeaway" hidden></div>
      </div>
      <div class="chartcard wide">
        <div class="cardhead"><div class="htitle"><h3>Top scorers &amp; assists</h3><p class="sub">Every squad player's goals and assists this season.</p></div><button class="infobtn" type="button" aria-label="About this chart"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Season goals and assists for every registered player. Source: FotMob.</span></button></div>
        <div class="canvas-holder"><canvas id="c-wscorers"></canvas></div><div class="note" id="n-wscorers" hidden></div>
      </div>
    </div>
  </section>
  {% endif %}

  <!-- SQUAD -->
  {% if page == 'squad' %}
  <section class="panel">
    <div class="block card">
    <div class="cardhead"><h3>Squad · {{ squad|length }} players</h3></div>
    {% if squad %}
    <div class="tablewrap">
      <table id="squad">
        <thead><tr>
          <th class="player" aria-sort="none"><button>Player</button></th>
          <th class="pos" aria-sort="none"><button>Pos</button></th>
          <th aria-sort="none"><button>Nat</button></th>
          <th aria-sort="none"><button>Age</button></th>
          <th aria-sort="none"><button>Apps</button></th>
          <th aria-sort="none"><button>G</button></th>
          <th aria-sort="none"><button>A</button></th>
          <th aria-sort="none"><button>Cards</button></th>
        </tr></thead>
        <tbody>
          {% for p in squad %}
          <tr>
            <td class="player" title="{{ p.full_name }}">{{ p.name }}</td>
            <td class="pos"><span class="pill p-{{ p.pos }}" title="{{ p.pos_detail or p.pos }}">{{ p.pos }}</span></td>
            <td title="{{ p.nationality or '' }}">{{ p.nat_code or '-' }}</td>
            <td>{{ p.age if p.age is not none else '-' }}</td>
            <td>{{ p.apps if p.apps is not none else '-' }}</td>
            <td>{{ p.goals if p.goals is not none else '-' }}</td>
            <td>{{ p.assists if p.assists is not none else '-' }}</td>
            <td>{% if p.ycards %}<span class="cardchip yellow" title="{{ p.ycards }} yellow"></span>{% endif %}{% if p.rcards %}<span class="cardchip red" title="{{ p.rcards }} red"></span>{% endif %}{% if not p.ycards and not p.rcards %}-{% endif %}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}<p class="empty-note">Squad list unavailable right now.</p>{% endif %}
    </div>
  </section>
  {% endif %}

  <!-- NEWS -->
  {% if page == 'news' %}
  <section class="panel">
    <div class="block card">
    <div class="cardhead"><h3>Latest news</h3></div>
    {% if news %}
    <ul class="list newslist">
      {% for a in news %}
      <li>
        {% if a.image %}<img class="thumb" src="{{ a.image|e }}" alt="" loading="lazy">{% endif %}
        <div class="body">
          <div class="meta"><span class="src">{{ a.source|e }}</span>{% if a.date_display %}<span class="date">{{ a.date_display|e }}</span>{% endif %}</div>
          <a class="headline" href="{{ a.link|e }}" target="_blank" rel="noopener noreferrer">{{ a.title|e }}</a>
          {% if a.summary %}<p class="summary">{{ a.summary|e }}</p>{% endif %}
        </div>
      </li>
      {% endfor %}
    </ul>
    <p class="empty-note" style="padding:14px 2px 0">Headlines from Ipswich-focused RSS feeds. Links open on the publisher's site.</p>
    {% else %}<p class="empty-note">No news available right now.</p>{% endif %}
    </div>
  </section>
  {% endif %}

</main>

<footer class="wrap">
  {% if health and health.missing %}<div class="health-note" role="status">⚠ Some data sources returned nothing on the last update: {{ health.missing|join(', ') }}. Those sections may be incomplete until the next successful rebuild.</div>{% endif %}
  Data from free, public sources — {{ league_name }} results, table and squad via FotMob, Ipswich RSS feeds (news) · rebuilt automatically via GitHub Actions.<br>
  This page deliberately omits xG, shot maps and other advanced stats shown on the men's team pages — those rely on data sources with no free women's-football coverage. <a href="../men/index.html">Men's team stats →</a><br>
  Raw data: <code>data/itfc_women.json</code> · A reference page, not affiliated with Ipswich Town FC.
</footer>

{% if page == 'charts' %}
<script id="itfc-data" type="application/json">{{ data_json|safe }}</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>
(function(){
  var _d = document.getElementById('itfc-data');
  var DATA = _d ? JSON.parse(_d.textContent) : {};
  [].forEach.call(document.querySelectorAll('canvas'), function(c){
    var card = c.closest('.chartcard'); if(!card) return;
    var h = card.querySelector('h3'), s = card.querySelector('.sub');
    c.setAttribute('role','img');
    c.setAttribute('aria-label', (h?h.textContent:'Chart') + (s?'. '+s.textContent:''));
  });

  var css = getComputedStyle(document.documentElement);
  function cv(n){ return css.getPropertyValue(n).trim(); }
  var C = {blue:cv('--primary'),red:cv('--loss'),amber:cv('--brand-orange'),green:cv('--win'),muted:cv('--stone'),line:cv('--chart-grid')};

  function showNote(id,msg){ var c=document.getElementById('c-'+id); if(c)c.style.display='none';
    var n=document.getElementById('n-'+id); if(n){n.hidden=false;n.textContent=msg;} }
  function baseOpts(extra){
    var o={responsive:true,maintainAspectRatio:false,
      plugins:{legend:{labels:{boxWidth:12,font:{size:12}}}},
      scales:{x:{grid:{display:false}},y:{grid:{color:C.line}}}};
    return Object.assign(o, extra||{});
  }

  if(!document.getElementById('c-wpoints')) return;
  if(!window.Chart){ ['wpoints','wgoals','whomeaway','wscorers'].forEach(function(id){showNote(id,'Charts library did not load.');}); return; }
  Chart.defaults.font.family="Inter, system-ui, sans-serif"; Chart.defaults.color=C.muted;

  var gw = DATA.by_gameweek||[];

  // Points progression: actual so far, projected to the end of the season
  // (a straight-line points-per-game extrapolation, not a simulation) at the
  // club's current pace. Season length is inferred from the table's team
  // count (a double round-robin), falling back to WSL2's usual 22 games.
  var tbl = DATA.table||[];
  var TOTAL_GW = tbl.length > 1 ? (tbl.length - 1) * 2 : 22;
  if(gw.length){
    var seasonLabels = []; for(var _g=1;_g<=TOTAL_GW;_g++) seasonLabels.push('M'+_g);
    var played = gw.length;
    var cumPts = gw.map(function(d){return d.cum_points;});
    var lastPts = cumPts[played-1], ppg = lastPts/played;
    var actualData = seasonLabels.map(function(_,i){return i < played ? cumPts[i] : null;});
    var projData = seasonLabels.map(function(_,i){var g=i+1;
      if(g < played) return null;
      if(g === played) return lastPts;
      return +(lastPts + ppg*(g-played)).toFixed(1);});
    new Chart(document.getElementById('c-wpoints'),{type:'line',
      data:{labels:seasonLabels,datasets:[
        {label:'Points',data:actualData,borderColor:C.blue,backgroundColor:'rgba(22,52,107,.10)',fill:true,tension:.2,pointRadius:3,spanGaps:false},
        {label:'Projected ('+Math.round(ppg*TOTAL_GW)+' pts)',data:projData,borderColor:C.blue,borderDash:[6,5],tension:.2,pointRadius:0,fill:false}]},
      options:baseOpts({scales:{x:{grid:{display:false},ticks:{maxTicksLimit:13}},y:{beginAtZero:true,grid:{color:C.line}}}})});
  } else showNote('wpoints','No matches played yet.');

  if(gw.length){
    new Chart(document.getElementById('c-wgoals'),{type:'bar',
      data:{labels:gw.map(function(d){return 'M'+d.gw;}),datasets:[
        {label:'For',data:gw.map(function(d){return d.gf;}),backgroundColor:C.blue},
        {label:'Against',data:gw.map(function(d){return d.ga;}),backgroundColor:C.red}]},
      options:baseOpts()});
  } else showNote('wgoals','No matches played yet.');

  if(gw.length){
    function agg(isHome){var m=gw.filter(function(x){return !!x.home===isHome;});
      if(!m.length) return null; var n=m.length,gf=0,ga=0,pts=0;
      m.forEach(function(x){gf+=x.gf;ga+=x.ga;pts+=x.pts;});
      return [pts/n,gf/n,ga/n].map(function(v){return +v.toFixed(2);});}
    var H=agg(true),A=agg(false);
    new Chart(document.getElementById('c-whomeaway'),{type:'bar',
      data:{labels:['PPG','Goals for','Goals against'],datasets:[
        {label:'Home',data:H||[0,0,0],backgroundColor:C.blue},
        {label:'Away',data:A||[0,0,0],backgroundColor:C.amber}]},
      options:baseOpts({scales:{x:{grid:{display:false}},y:{beginAtZero:true,grid:{color:C.line}}}})});
  } else showNote('whomeaway','No match data yet.');

  var squad = (DATA.squad||[]).filter(function(p){return (p.goals||0)+(p.assists||0) > 0;})
    .sort(function(a,b){return (b.goals||0)+(b.assists||0) - ((a.goals||0)+(a.assists||0));});
  if(squad.length){
    new Chart(document.getElementById('c-wscorers'),{type:'bar',
      data:{labels:squad.map(function(p){return p.name;}),datasets:[
        {label:'Goals',data:squad.map(function(p){return p.goals||0;}),backgroundColor:C.blue},
        {label:'Assists',data:squad.map(function(p){return p.assists||0;}),backgroundColor:C.amber}]},
      options:baseOpts({indexAxis:'y',scales:{x:{beginAtZero:true,grid:{color:C.line}},y:{grid:{display:false}}}})});
  } else showNote('wscorers','No goal involvements yet.');
})();
</script>
{% endif %}

</body>
</html>
