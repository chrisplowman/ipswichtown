<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ og_title or ('Ipswich Town · ' + season + ' Reference') }}</title>
<meta name="description" content="{{ og_description or 'Ipswich Town Premier League stats.' }}">
{% if canonical %}<link rel="canonical" href="{{ canonical }}">{% endif %}
<meta property="og:type" content="website">
<meta property="og:title" content="{{ og_title or 'Ipswich Town Stats' }}">
<meta property="og:description" content="{{ og_description or '' }}">
{% if og_image %}<meta property="og:image" content="{{ og_image }}">{% endif %}
{% if canonical %}<meta property="og:url" content="{{ canonical }}">{% endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title or 'Ipswich Town Stats' }}">
<meta name="twitter:description" content="{{ og_description or '' }}">
{% if og_image %}<meta name="twitter:image" content="{{ og_image }}">{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ css_href }}">
<script>
(function(){var K='itfc-theme',d=document.documentElement;
 // Only the first page view of a session gets the card rise-in animation;
 // every tab click after that is a full navigation and shouldn't replay it.
 try{if(sessionStorage.getItem('itfc-seen')){d.classList.add('seen');}else{sessionStorage.setItem('itfc-seen','1');}}catch(e){}
 function set(t){d.setAttribute('data-theme',t);}
 try{set(localStorage.getItem(K)||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'));}catch(e){set('light');}
 window.__setTheme=function(t){
   // Charts bake their colours in from CSS vars at build time (see cv() below),
   // so a theme switch needs a fresh load to recolour them correctly rather than
   // patching chart chrome in place — most visible jumping into/out of teletext.
   set(t);try{localStorage.setItem(K,t);}catch(e){}
   location.reload();
 };
})();
</script>
</head>
<body class="page-{{ page }}">
{% include '_masthead.html.j2' %}

<main class="wrap" id="main" tabindex="-1">

  <!-- OVERVIEW -->
  {% if page == 'overview' %}
  <section class="panel">
    {% if summary_text or survival %}
    <div class="block">
      <div class="cols">
        {% if summary_text %}
        <div class="snapshot">
          <div class="cardhead">
            <div class="snapshot-label">Season snapshot</div>
            <button class="infobtn" type="button" aria-label="About this summary"><span aria-hidden="true">i</span><span class="tip" role="tooltip">An auto-written read of the season from points-per-game pace, Understat expected points and goal difference. Source: FPL API and Understat.</span></button>
          </div>
          <p>{{ summary_text }}</p>
        </div>
        {% endif %}
        {% if survival %}
        <div class="survival">
          <div class="cardhead">
            <div class="snapshot-label">Survival forecast</div>
            <button class="infobtn" type="button" aria-label="About this forecast"><span aria-hidden="true">i</span><span class="tip" role="tooltip">A Monte Carlo simulation of every remaining fixture ({{ '{:,}'.format(survival.sims) }} runs), using Elo-based win probabilities. Source: ClubElo ratings and the FPL fixture list.</span></button>
          </div>
          <div class="surv-big">{{ survival.survive_pct }}%</div>
          <div class="surv-sub">chance of avoiding relegation</div>
          <div class="surv-bar" role="img" aria-label="{{ survival.survive_pct }}% survival, {{ survival.releg_pct }}% relegation">
            <span class="surv-safe" style="width:{{ survival.survive_pct }}%"></span><span class="surv-rel" style="width:{{ survival.releg_pct }}%"></span>
          </div>
          <div class="surv-meta">Projected finish ~{{ survival.avg_position }}th on {{ survival.avg_points }} pts (likely {{ survival.pts_lo }}–{{ survival.pts_hi }}). From {{ '{:,}'.format(survival.sims) }} simulations.</div>
        </div>
        {% endif %}
      </div>
    </div>
    {% endif %}
    <div class="block card">
      <div class="cardhead"><h3>Next fixture</h3><button class="infobtn" type="button" aria-label="About this data"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Kickoff details, opponent form and a win probability modelled from Elo ratings, plus the head-to-head record from recent meetings. Source: FPL fixtures, ClubElo and football-data.co.uk.</span></button></div>
      {% if next_fixture %}
      <div class="board">
        <div class="row">
          <div class="side">{% if team.badge %}<img class="badge-lg" src="{{ team.badge }}" alt="">{% endif %}<div class="abbr">{{ team.short_name }}</div><div class="full">Ipswich Town</div></div>
          <div class="vs">{{ "HOME" if next_fixture.home else "AWAY" }}</div>
          <div class="side">{% if next_fixture.badge %}<img class="badge-lg" src="{{ next_fixture.badge }}" alt="">{% endif %}<div class="abbr">{{ next_fixture.opponent_short }}</div><div class="full">{{ next_fixture.opponent }}</div></div>
        </div>
        <div class="when">{{ next_fixture.kickoff|kickoff }} · <span class="venue">{{ "Portman Road" if next_fixture.home else "Away" }}</span>{% if next_fixture.event %} · GW{{ next_fixture.event }}{% endif %}</div>
        {% if next_opponent and (next_opponent.position or next_opponent.xg_pg is not none or next_opponent.prob or next_opponent.h2h_record) %}
        <div class="oppdetail">
          <div class="opprow">
            <div class="who">
              <div class="nm">{{ next_opponent.name }}</div>
              <div class="sub">{% if next_opponent.position %}{{ next_opponent.position|ordinal }}{% if next_opponent.points is not none %} · {{ next_opponent.points }} pts{% endif %}{% if next_opponent.gd is not none %} · {{ '%+d'|format(next_opponent.gd) }} GD{% endif %}{% endif %}</div>
            </div>
            {% if next_opponent.form %}
            <div class="metric"><div class="formdots">{% for f in next_opponent.form %}<i class="{{ f }}">{{ f }}</i>{% endfor %}</div><div class="k">Last 5</div></div>
            {% endif %}
            <div class="metrics">
              {% if next_opponent.xg_pg is not none %}<div class="metric"><div class="v">{{ '%.2f'|format(next_opponent.xg_pg) }}</div><div class="k">xG / game</div></div>{% endif %}
              {% if next_opponent.xga_pg is not none %}<div class="metric"><div class="v">{{ '%.2f'|format(next_opponent.xga_pg) }}</div><div class="k">xGA / game</div></div>{% endif %}
            </div>
          </div>
          {% if next_opponent.prob %}
          <div class="winprob">
            <div class="wp-bar">
              <span class="wp-w" style="width:{{ next_opponent.prob.ipswich }}%">{{ next_opponent.prob.ipswich }}%</span>
              <span class="wp-d" style="width:{{ next_opponent.prob.draw }}%">{{ next_opponent.prob.draw }}%</span>
              <span class="wp-l" style="width:{{ next_opponent.prob.opponent }}%">{{ next_opponent.prob.opponent }}%</span>
            </div>
            <div class="wp-key"><span>Ipswich win</span><span>Draw</span><span>{{ next_opponent.short }} win</span></div>
          </div>
          {% endif %}
          {% if next_opponent.h2h_record %}
          <div class="h2h">
            <span class="h2h-label">Recent meetings</span>
            <span class="h2h-rec">{{ next_opponent.h2h_record.w }}W {{ next_opponent.h2h_record.d }}D {{ next_opponent.h2h_record.l }}L</span>
            <span class="h2h-dots">{% for m in next_opponent.h2h %}<i class="{{ m.result }}" title="{{ m.date }} {{ '(H)' if m.home else '(A)' }} {{ m.score }}">{{ m.result }}</i>{% endfor %}</span>
          </div>
          {% endif %}
        </div>
        {% endif %}
      </div>
      {% else %}<div class="board empty"><div class="row">No upcoming fixtures scheduled yet.</div></div>{% endif %}
    </div>

    {% if team_news %}
    <div class="block">
      <div class="card">
        <div class="cardhead"><h3>Team news</h3><button class="infobtn" type="button" aria-label="About this data"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Injuries, suspensions and doubts, read from each player's status and news fields. Source: Fantasy Premier League API.</span></button></div>
        <ul class="list news">
          {% for t in team_news %}
          <li>
            <span class="nm">{{ t.player }}</span>
            <span class="reason">{{ t.news }}</span>
            <span class="tag {{ t.sev }}">{{ t.tag }}</span>
          </li>
          {% endfor %}
        </ul>
      </div>
    </div>
    {% endif %}

    {% if form_guide %}
    <div class="block">
      <div class="formguide">
        <div class="fg-head">
          <div class="hgroup">
            <span class="fg-label">Form guide · last {{ form_guide.count }}</span>
            <button class="infobtn" type="button" aria-label="About this data"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Points from the last {{ form_guide.count }} matches, momentum from the newer half's PPG vs the older half's, and a verdict against xPts. Source: FPL results and Understat.</span></button>
          </div>
          <span class="fg-summary">{{ form_guide.pts }} pts · {{ '%.2f'|format(form_guide.ppg) }} PPG
            <span class="fg-trend {{ form_guide.trend }}" title="Momentum {{ form_guide.trend }}">{{ {'up':'▲','down':'▼','flat':'▬'}[form_guide.trend] }}</span></span>
        </div>
        <div class="fg-tiles">
          {% for m in form_guide.matches %}
          <div class="fg-tile">
            <div class="fg-tile-top">
              <span class="res {{ m.result }}">{{ m.result }}</span>
              <span class="fg-tile-opp">{{ m.opponent_short or m.opponent }}</span>
            </div>
            <div class="fg-tile-meta">{{ 'H' if m.home else 'A' }}{% if m.event %} · GW{{ m.event }}{% endif %}</div>
            <div class="fg-tile-score">{{ m.score }}</div>
            <div class="fg-tile-rows">
              <div><span class="k">Pts</span><span class="v">{{ m.pts }}</span></div>
              {% if m.xpts is not none %}<div><span class="k">xPts</span><span class="v">{{ '%.2f'|format(m.xpts) }}</span></div>{% endif %}
              {% if m.xg_for is not none %}<div><span class="k">xG</span><span class="v">{{ '%.2f'|format(m.xg_for) }}-{{ '%.2f'|format(m.xg_against) }}</span></div>{% endif %}
            </div>
            {% if m.match_id %}<a class="fg-tile-link" href="match/{{ m.match_id }}.html">Report →</a>{% endif %}
          </div>
          {% endfor %}
        </div>
        {% if form_guide.xpts is not none or form_guide.run_label %}
        <div class="fg-analysis">
          {% if form_guide.xpts is not none %}<span class="fg-chip"><span class="k">Deserved (xPts)</span> <b>{{ form_guide.xpts }}</b> pts</span>{% endif %}
          {% if form_guide.xgf is not none %}<span class="fg-chip"><span class="k">xG</span> <b>{{ form_guide.xgf }}</b>-<b>{{ form_guide.xga }}</b></span>{% endif %}
          {% if form_guide.run_label %}<span class="fg-chip"><span class="k">Run</span> {{ form_guide.run_label }} (opponents avg {{ form_guide.opp_avg_rank|ordinal }})</span>{% endif %}
          {% if form_guide.verdict %}<span class="fg-verdict {{ form_guide.verdict }}">{{ {'over':'Outperforming expectation','under':'Underperforming expectation','par':'In line with expectation'}[form_guide.verdict] }}</span>{% endif %}
        </div>
        {% endif %}
      </div>
    </div>
    {% endif %}

    <div class="block">
      <div class="cols">
        {% if rivals %}
        <div class="card">
          <div class="cardhead"><h3>The relegation picture</h3><button class="infobtn" type="button" aria-label="About this table"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Clubs immediately around Ipswich, with recent form and relegation odds from the season-simulation model. Source: ESPN table and ClubElo-based simulation.</span></button></div>
          <table class="rivaltable">
            <thead><tr><th>#</th><th>Team</th><th>Pts</th><th>Form</th><th>Drop%</th></tr></thead>
            <tbody>
              {% for r in rivals %}
              <tr class="{{ 'ips' if r.is_ipswich }}">
                <td>{{ r.rank }}</td>
                <td class="tm">{% if r.badge %}<img class="badge" src="{{ r.badge }}" alt="">{% endif %}{{ r.team }}</td>
                <td><b>{{ r.points }}</b></td>
                <td class="formcol">{% for f in r.form %}<span class="fdot {{ f }}"></span>{% endfor %}</td>
                <td>{{ ('%.0f'|format(r.releg)) + '%' if r.releg is not none else '-' }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% endif %}
        <div class="card">
          <div class="cardhead"><h3>Season record</h3><button class="infobtn" type="button" aria-label="About this data"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Results and goals for the season so far, with Ipswich's league rank on each measure. Source: Fantasy Premier League API and the league table.</span></button></div>
          <table class="reftable">
            <thead><tr><th>Record</th><th></th><th>Rank</th></tr></thead>
            <tbody>
              <tr><td>Points</td><td class="v accent">{{ summary.points }}</td><td>{% if summary_ranks.points %}{{ summary_ranks.points|ordinal }}{% else %}–{% endif %}</td></tr>
              <tr><td>Played</td><td class="v">{{ summary.played }}</td><td>–</td></tr>
              <tr><td>Won</td><td class="v">{{ summary.won }}</td><td>{% if summary_ranks.won %}{{ summary_ranks.won|ordinal }}{% else %}–{% endif %}</td></tr>
              <tr><td>Drawn</td><td class="v">{{ summary.drawn }}</td><td>–</td></tr>
              <tr><td>Lost</td><td class="v">{{ summary.lost }}</td><td>{% if summary_ranks.lost %}{{ summary_ranks.lost|ordinal }}{% else %}–{% endif %}</td></tr>
              <tr><td>Goals for</td><td class="v">{{ summary.gf }}</td><td>{% if summary_ranks.gf %}{{ summary_ranks.gf|ordinal }}{% else %}–{% endif %}</td></tr>
              <tr><td>Goals against</td><td class="v">{{ summary.ga }}</td><td>{% if summary_ranks.ga %}{{ summary_ranks.ga|ordinal }}{% else %}–{% endif %}</td></tr>
              <tr><td>Goal diff</td><td class="v {{ 'pos' if summary.gd>0 else 'neg' if summary.gd<0 else '' }}">{{ '%+d'|format(summary.gd) if summary.gd else 0 }}</td><td>{% if summary_ranks.gd %}{{ summary_ranks.gd|ordinal }}{% else %}–{% endif %}</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="block">
      <div class="cols">
        <div class="card">
          <div class="cardhead"><h3>Fixtures</h3><button class="infobtn" type="button" aria-label="About this data"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Upcoming fixtures with FPL's difficulty rating (1 easy to 5 hard). Source: Fantasy Premier League API.</span></button></div>
          {% set upcoming_fx = fixtures|rejectattr('finished')|list %}
          {% if upcoming_fx %}
          <ul class="list">
            {% for f in upcoming_fx %}
            <li>
              <span class="gw">{{ ('GW'+f.event|string) if f.event else '' }}</span>
              <span class="opp">{% if f.badge %}<img class="badge" src="{{ f.badge }}" alt="">{% endif %}{{ f.opponent }}<span class="ha">{{ '(H)' if f.home else '(A)' }}</span></span>
              <span class="kick">{{ f.kickoff|kickoff }}</span><span class="fdr fdr-{{ f.difficulty or 3 }}" title="Fixture difficulty {{ f.difficulty }}/5">{{ f.difficulty or '–' }}</span>
            </li>
            {% endfor %}
          </ul>
          {% else %}<p class="empty-note">No upcoming fixtures. The season is complete.</p>{% endif %}
        </div>
        <div class="card">
          <div class="cardhead"><h3>Results</h3><button class="infobtn" type="button" aria-label="About this data"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Full-time results this season. Source: Fantasy Premier League API.</span></button></div>
          {% if results %}
          <ul class="list">
            {% for r in results %}
            <li{% if r.match_id %} class="has-link"{% endif %}>{% if r.match_id %}<a class="rowlink" href="match/{{ r.match_id }}.html" aria-label="Match report: Ipswich vs {{ r.opponent }}"></a>{% endif %}<span class="gw">{{ ('GW'+r.event|string) if r.event else '' }}</span><span class="res {{ r.result }}">{{ r.result }}</span><span class="opp">{% if r.badge %}<img class="badge" src="{{ r.badge }}" alt="">{% endif %}{{ r.opponent }}<span class="ha">{{ '(H)' if r.home else '(A)' }}</span></span><span class="score">{{ r.score }}</span></li>
            {% endfor %}
          </ul>
          {% else %}<p class="empty-note">No matches played yet. The season opens on 22 August.</p>{% endif %}
        </div>
      </div>
    </div>
  </section>

  <!-- TABLE -->
  {% endif %}
  {% if page == 'table' %}
  <section class="panel">
    <div class="block card">
    <div class="cardhead"><h3>Premier League table</h3><button class="infobtn" type="button" aria-label="About this data"><span aria-hidden="true">i</span><span class="tip" role="tooltip">The live Premier League table. Source: ESPN's public standings endpoint.</span></button></div>
    {% if table %}
    <div class="tablewrap">
      <table class="ltable">
        <thead><tr>
          <th class="rk">#</th><th class="tm">Team</th>
          <th>P</th><th>W</th><th>D</th><th>L</th><th>GF</th><th>GA</th><th>GD</th><th>Pts</th><th class="formcol">Form</th>
        </tr></thead>
        <tbody>
          {% for row in table %}
          <tr class="{{ 'ips ' if row.is_ipswich }}{{ 'eur' if row.rank<=5 else 'rel' if row.rank>=18 else '' }}">
            <td class="rk">{{ row.rank }}</td>
            <td class="tm">{% if row.badge %}<img class="badge" src="{{ row.badge }}" alt="">{% endif %}{{ row.team }}</td>
            <td>{{ row.played }}</td><td>{{ row.won }}</td><td>{{ row.drawn }}</td><td>{{ row.lost }}</td>
            <td>{{ row.gf }}</td><td>{{ row.ga }}</td><td>{{ '%+d'|format(row.gd) if row.gd else 0 }}</td>
            <td><b>{{ row.points }}</b></td>
            <td class="formcol">{% for r in row.form %}<span class="fdot {{ r }}" title="{{ r }}"></span>{% endfor %}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <div class="lkey">
      <span><i style="background:var(--win)"></i> Top 5</span>
      <span><i style="background:var(--loss)"></i> Relegation</span>
      <span><i style="background:var(--tint-sky);border:1px solid var(--hairline)"></i> Ipswich</span>
    </div>
    {% else %}<p class="empty-note">League table unavailable right now. It will appear on the next successful update.</p>{% endif %}
    </div>

    <div class="block card">
    <div class="cardhead"><h3>Projected final table</h3><button class="infobtn" type="button" aria-label="About this projection"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Every club's current points-per-game extrapolated to 38 games: a straight-line projection, not a simulation. Source: ESPN table.</span></button></div>
    {% if predicted and predicted[0].proj is not none %}
    <p class="empty-note" style="padding:0 2px 12px">Where the season ends if every club keeps its current points-per-game: a projection, not a prediction.</p>
    <div class="tablewrap">
      <table class="ltable">
        <thead><tr>
          <th class="rk">#</th><th class="tm">Team</th>
          <th>P</th><th>Pts</th><th>PPG</th><th>Proj</th>
        </tr></thead>
        <tbody>
          {% for row in predicted %}
          <tr class="{{ 'ips ' if row.is_ipswich }}{{ 'eur' if row.proj_rank<=5 else 'rel' if row.proj_rank>=18 else '' }}">
            <td class="rk">{{ row.proj_rank }}</td>
            <td class="tm">{% if row.badge %}<img class="badge" src="{{ row.badge }}" alt="">{% endif %}{{ row.team }}</td>
            <td>{{ row.played }}</td><td>{{ row.points }}</td><td>{{ '%.2f'|format(row.ppg) }}</td>
            <td><b>{{ row.proj }}</b></td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}<p class="empty-note">Available once the season is under way.</p>{% endif %}
    </div>

    <div class="block card">
    <div class="cardhead"><h3>Underlying numbers</h3><button class="infobtn" type="button" aria-label="About this data"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Every club's actual points next to the numbers behind them: expected goals for/against, non-penalty xG, pressing intensity (PPDA) and current Elo rating. The Δ column is actual points minus Understat's xPts — positive means outperforming the underlying play, negative means the table flatters them. Source: Understat and ClubElo.</span></button></div>
    {% if league_table %}
    <p class="empty-note" style="padding:0 2px 12px">Same 20 clubs, ranked by actual points — but with the numbers a plain table can't show. Click any column to sort.</p>
    <div class="tablewrap">
      <table class="ltable" id="underlying-table">
        <thead><tr>
          <th class="rk" aria-sort="none"><button>#</button></th>
          <th class="tm" aria-sort="none"><button>Team</button></th>
          <th aria-sort="none"><button>Pts</button></th>
          <th aria-sort="none"><button>GD</button></th>
          <th aria-sort="none"><button>xG</button></th>
          <th aria-sort="none"><button>xGA</button></th>
          <th aria-sort="none"><button>npxG</button></th>
          <th aria-sort="none"><button>PPDA</button></th>
          <th aria-sort="none"><button>Elo</button></th>
          <th aria-sort="none"><button>xPts</button></th>
          <th aria-sort="none"><button>Δ</button></th>
        </tr></thead>
        <tbody>
          {% for row in league_table %}
          <tr class="{{ 'ips ' if row.is_ipswich }}{{ 'eur' if row.rank<=5 else 'rel' if row.rank>=18 else '' }}">
            <td class="rk">{{ row.rank }}</td>
            <td class="tm">{% if row.badge %}<img class="badge" src="{{ row.badge }}" alt="">{% endif %}{{ row.team }}</td>
            <td><b>{{ row.points }}</b></td>
            <td>{{ '%+d'|format(row.gd) if row.gd else 0 }}</td>
            <td>{{ '%.1f'|format(row.xg) if row.xg is not none else '–' }}</td>
            <td>{{ '%.1f'|format(row.xga) if row.xga is not none else '–' }}</td>
            <td>{{ '%.1f'|format(row.npxg) if row.npxg is not none else '–' }}</td>
            <td>{{ '%.1f'|format(row.ppda) if row.ppda is not none else '–' }}</td>
            <td>{{ row.elo if row.elo is not none else '–' }}</td>
            <td>{{ '%.1f'|format(row.xpts) if row.xpts is not none else '–' }}</td>
            <td class="diff {{ 'pos' if (row.xpts_diff or 0) > 0 else 'neg' if (row.xpts_diff or 0) < 0 else '' }}">{{ '%+.1f'|format(row.xpts_diff) if row.xpts_diff is not none else '–' }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}<p class="empty-note">Available once the season is under way.</p>{% endif %}
    </div>

    {% if home_table %}
    {% for title, tbl in [('Home table', home_table), ('Away table', away_table)] %}
    <div class="block card">
    <div class="cardhead"><h3>{{ title }}</h3><button class="infobtn" type="button" aria-label="About this data"><span aria-hidden="true">i</span><span class="tip" role="tooltip">The league table split by home and away results this season. Source: football-data.co.uk match results.</span></button></div>
    <div class="tablewrap">
      <table class="ltable">
        <thead><tr>
          <th class="rk">#</th><th class="tm">Team</th>
          <th>P</th><th>W</th><th>D</th><th>L</th><th>GF</th><th>GA</th><th>GD</th><th>Pts</th>
        </tr></thead>
        <tbody>
          {% for row in tbl %}
          <tr class="{{ 'ips ' if row.is_ipswich }}{{ 'eur' if row.rank<=5 else 'rel' if row.rank>=18 else '' }}">
            <td class="rk">{{ row.rank }}</td>
            <td class="tm">{% if row.badge %}<img class="badge" src="{{ row.badge }}" alt="">{% endif %}{{ row.team }}</td>
            <td>{{ row.played }}</td><td>{{ row.won }}</td><td>{{ row.drawn }}</td><td>{{ row.lost }}</td>
            <td>{{ row.gf }}</td><td>{{ row.ga }}</td><td>{{ '%+d'|format(row.gd) if row.gd else 0 }}</td>
            <td><b>{{ row.points }}</b></td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    </div>
    {% endfor %}
    {% endif %}
  </section>

  <!-- CHARTS -->
  {% endif %}
  {% if page == 'charts' %}
  <section class="panel">

    <nav class="chartjump" aria-label="Jump to chart section">
      <div class="wrap">
        <a href="#cs-form">Form &amp; season</a>
        <a href="#cs-attack">Attack</a>
        <a href="#cs-defence">Defence &amp; pressing</a>
        <a href="#cs-timing">Timing &amp; game-state</a>
        <a href="#cs-discipline">Discipline</a>
        <a href="#cs-league">League context</a>
      </div>
    </nav>
    <p class="label" id="cs-form">Form &amp; season</p>
    <div class="chartgrid">
      <div class="chartcard wide">
        <div class="cardhead"><div class="htitle"><h3>Points progression</h3><p class="sub">Points so far (solid), projected to GW38 at the club's current rate (dashed), against the pace the 17th-placed team is on. Above the red line = on course to survive.</p></div><button class="infobtn" type="button" aria-label="About this chart"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Cumulative points from full-time results, projected to GW38 at the club's current points-per-game. Source: Fantasy Premier League API.</span></button></div>
        <div class="canvas-holder"><canvas id="c-points"></canvas></div><div class="note" id="n-points" hidden></div>
      </div>
      <div class="chartcard wide">
        <div class="cardhead"><div class="htitle"><h3>Expected points vs actual</h3><p class="sub">Cumulative points vs the points the club's performances "deserved" (Understat xPts). Above the line = picking up more than the underlying play merits.</p></div><button class="infobtn" type="button" aria-label="About this chart"><span aria-hidden="true">i</span><span class="tip" role="tooltip">xPts sums each match's expected outcome from Understat's match xG model. Source: Understat.</span></button></div>
        <div class="canvas-holder"><canvas id="c-xpts"></canvas></div><div class="note" id="n-xpts" hidden></div>
      </div>
      <div class="chartcard wide">
        <div class="cardhead"><div class="htitle"><h3>Elo trend</h3><p class="sub">The club's ClubElo rating through the season: a single-number measure of strength. Rising = getting stronger relative to the field.</p></div><button class="infobtn" type="button" aria-label="About this chart"><span aria-hidden="true">i</span><span class="tip" role="tooltip">The club's published Elo rating history. Source: ClubElo.</span></button></div>
        <div class="canvas-holder"><canvas id="c-elo"></canvas></div><div class="note" id="n-elo" hidden></div>
      </div>
      <div class="chartcard wide">
        <div class="cardhead"><div class="htitle"><h3>Rolling xG difference</h3><p class="sub">xG created minus xG conceded, averaged over the last 5 games. Above zero = on top of matches; the slope shows momentum.</p></div><button class="infobtn" type="button" aria-label="About this chart"><span aria-hidden="true">i</span><span class="tip" role="tooltip">xG created minus xG conceded per match, averaged over the last 5 games. Source: Understat.</span></button></div>
        <div class="canvas-holder"><canvas id="c-xgd"></canvas></div><div class="note" id="n-xgd" hidden></div>
      </div>
      <div class="chartcard wide">
        <div class="cardhead"><div class="htitle"><h3>xG created vs conceded, per match</h3><p class="sub">Ipswich's xG against the opponent's, match by match, with each side's season average as a dashed line.</p></div><button class="infobtn" type="button" aria-label="About this chart"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Expected goals created and conceded per match, with the season average for each. Source: Understat.</span></button></div>
        <div class="canvas-holder"><canvas id="c-xgvs"></canvas></div><div class="note" id="n-xgvs" hidden></div>
      </div>
      <div class="chartcard wide">
        <div class="cardhead"><div class="htitle"><h3>Home &amp; away split</h3><p class="sub">Per-game points, goals and xG at home vs away: how differently the side performs by venue.</p></div><button class="infobtn" type="button" aria-label="About this chart"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Points, goals and xG per game, split by venue. Source: Understat match data.</span></button></div>
        <div class="canvas-holder"><canvas id="c-homeaway"></canvas></div><div class="note" id="n-homeaway" hidden></div>
      </div>
    </div>
    <p class="label" id="cs-attack">Attack</p>
    <div class="chartgrid">
      <div class="chartcard">
        <div class="cardhead"><div class="htitle"><h3>Attack: goals vs xG</h3><p class="sub">Cumulative goals vs expected goals (Understat). Above the line = finishing better than the chances created.</p></div><button class="infobtn" type="button" aria-label="About this chart"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Cumulative goals vs Understat's expected goals model. Source: Understat.</span></button></div>
        <div class="canvas-holder"><canvas id="c-xg"></canvas></div><div class="note" id="n-xg" hidden></div>
      </div>
      <div class="chartcard">
        <div class="cardhead"><div class="htitle"><h3>Finishing: goals vs npxG</h3><p class="sub">Non-penalty. Above the dashed line = outscoring the model.</p></div><button class="infobtn" type="button" aria-label="About this chart"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Non-penalty goals vs non-penalty expected goals per match. Source: Understat.</span></button></div>
        <div class="canvas-holder"><canvas id="c-finish"></canvas></div><div class="note" id="n-finish" hidden></div>
      </div>
      <div class="chartcard wide">
        <div class="cardhead"><div class="htitle"><h3>Goals by gameweek</h3><p class="sub">Goals scored and conceded in each match: a quick read of the club's best and worst weeks.</p></div><button class="infobtn" type="button" aria-label="About this chart"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Goals scored and conceded, gameweek by gameweek. Source: Fantasy Premier League API.</span></button></div>
        <div class="canvas-holder"><canvas id="c-goals"></canvas></div><div class="note" id="n-goals" hidden></div>
      </div>
      <div class="chartcard wide">
        <div class="cardhead"><div class="htitle"><h3>Shots for &amp; against</h3><p class="sub">Actual shots (and shots on target) taken vs faced each match. Real volume, not xG. Out-shooting opponents is a good sign.</p></div><button class="infobtn" type="button" aria-label="About this chart"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Total shots and shots on target, for and against, per match. Source: Understat.</span></button></div>
        <div class="canvas-holder"><canvas id="c-shots"></canvas></div><div class="note" id="n-shots" hidden></div>
      </div>
      <div class="chartcard wide">
        <div class="cardhead"><div class="htitle"><h3>Where shots come from</h3><p class="sub">Breakdown of shots by situation across the season: open play, set pieces, corners and penalties.</p></div><button class="infobtn" type="button" aria-label="About this chart"><span aria-hidden="true">i</span><span class="tip" role="tooltip">How the club's shots this season break down by situation. Source: Understat shot-level data.</span></button></div>
        <div class="canvas-holder"><canvas id="c-situation"></canvas></div><div class="note" id="n-situation" hidden></div>
      </div>
      <div class="chartcard wide">
        <div class="cardhead"><div class="htitle"><h3>Set-piece conversion</h3><p class="sub">Goals scored as a share of shots taken, by situation: how clinical the club is from each type of chance. Numbers in brackets are the shot count behind each rate.</p></div><button class="infobtn" type="button" aria-label="About this chart"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Goals divided by shots for each shot situation this season. Source: Understat shot-level data.</span></button></div>
        <div class="canvas-holder"><canvas id="c-setpiece"></canvas></div><div class="note" id="n-setpiece" hidden></div>
      </div>
      <div class="chartcard wide">
        <div class="cardhead"><div class="htitle"><h3>Shot map</h3><p class="sub">Every shot this season, placed by pitch location. Circle size = chance quality (xG), colour = outcome. Pick a single match from the list to zoom in.</p></div><button class="infobtn" type="button" aria-label="About this chart"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Every shot's pitch location, quality (xG) and outcome — for the whole season by default, or a single selected match. Source: Understat.</span></button></div>
        <div class="shotbar">
          <select id="shot-select" aria-label="Choose match"></select>
          <span class="shotscore" id="shot-score"></span>
        </div>
        <div class="matchreport" id="match-report" hidden></div>
        <div class="pitch-holder" id="pitch"></div>
        <div class="note" id="n-shot" hidden></div>
        <div class="shotkey">
          <span><i style="background:#2e9e5b"></i> Goal</span>
          <span><i style="background:#3f7ddb"></i> Saved</span>
          <span><i style="background:#e0a53b"></i> Blocked</span>
          <span><i style="background:#9aa6b8"></i> Off target</span>
          <span style="margin-left:auto">Circle size = xG</span>
        </div>
      </div>
      <div class="chartcard wide">
        <div class="cardhead"><div class="htitle"><h3>Chances taken &amp; missed</h3><p class="sub">Season extremes by chance quality (xG): the toughest chance converted, and the easiest chances spurned.</p></div><button class="infobtn" type="button" aria-label="About this chart"><span aria-hidden="true">i</span><span class="tip" role="tooltip">The lowest-xG shot that produced a goal, and the highest-xG shots that didn't, this season. Source: Understat shot-level data.</span></button></div>
        <div class="cols2" id="chances-cols">
          <div>
            <h4 class="subhead">Hardest chances taken</h4>
            <ul class="list chancelist" id="chances-hardest"></ul>
          </div>
          <div>
            <h4 class="subhead">Easiest chances missed</h4>
            <ul class="list chancelist" id="chances-easiest"></ul>
          </div>
        </div>
        <div class="note" id="n-chances" hidden></div>
      </div>
    </div>
    <p class="label" id="cs-defence">Defence &amp; pressing</p>
    <div class="chartgrid">
      <div class="chartcard wide">
        <div class="cardhead"><div class="htitle"><h3>Defence: conceded vs xG against</h3><p class="sub">Cumulative goals conceded vs expected (Understat). Below the line = keeping out chances the club would expect to concede.</p></div><button class="infobtn" type="button" aria-label="About this chart"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Cumulative goals conceded vs Understat's expected goals against. Source: Understat.</span></button></div>
        <div class="canvas-holder"><canvas id="c-xga"></canvas></div><div class="note" id="n-xga" hidden></div>
      </div>
      <div class="chartcard wide">
        <div class="cardhead"><div class="htitle"><h3>Pressing intensity (PPDA)</h3><p class="sub">Passes the opponent completes per defensive action the club makes, 5-game average. Lower = pressing higher and harder.</p></div><button class="infobtn" type="button" aria-label="About this chart"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Opponent passes allowed per defensive action, a lower-is-more-aggressive pressing metric, 5-game average. Source: Understat.</span></button></div>
        <div class="canvas-holder"><canvas id="c-ppda"></canvas></div><div class="note" id="n-ppda" hidden></div>
      </div>
      <div class="chartcard wide">
        <div class="cardhead"><div class="htitle"><h3>Territory: deep completions</h3><p class="sub">Passes completed near the opponent's box, for and against, per match. A read on which side controlled dangerous territory.</p></div><button class="infobtn" type="button" aria-label="About this chart"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Passes completed within 20 yards of goal, for and against, per match. Source: Understat.</span></button></div>
        <div class="canvas-holder"><canvas id="c-deep"></canvas></div><div class="note" id="n-deep" hidden></div>
      </div>
    </div>
    <p class="label" id="cs-timing">Timing &amp; game-state</p>
    <div class="chartgrid">
      <div class="chartcard wide">
        <div class="cardhead"><div class="htitle"><h3>Goals by 15-minute phase</h3><p class="sub">When the club scores and concedes across the match: a read on fast starts, strong finishes and vulnerable spells.</p></div><button class="infobtn" type="button" aria-label="About this chart"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Goals scored and conceded, grouped into 15-minute windows across the match. Source: Understat shot timing.</span></button></div>
        <div class="canvas-holder"><canvas id="c-timing"></canvas></div><div class="note" id="n-timing" hidden></div>
      </div>
      <div class="chartcard wide">
        <div class="cardhead"><div class="htitle"><h3>Points by half-time state</h3><p class="sub">Points won per game when ahead, level or behind at the break: how the club closes matches out.</p></div><button class="infobtn" type="button" aria-label="About this chart"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Points won per game depending on the scoreline at half-time. Source: football-data.co.uk match results.</span></button></div>
        <div class="canvas-holder"><canvas id="c-gamestate"></canvas></div><div class="note" id="n-gamestate" hidden></div>
      </div>
    </div>
    <p class="label" id="cs-discipline">Discipline</p>
    <div class="chartgrid">
      <div class="chartcard wide">
        <div class="cardhead"><div class="htitle"><h3>Discipline</h3><p class="sub">Fouls and cards per game, for and against: how the club's discipline compares with what it draws from opponents.</p></div><button class="infobtn" type="button" aria-label="About this chart"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Fouls and cards per game, for and against. Source: ESPN match events, with football-data.co.uk as a fallback.</span></button></div>
        <div class="canvas-holder"><canvas id="c-discipline"></canvas></div><div class="note" id="n-discipline" hidden></div>
      </div>
    </div>
    <p class="label" id="cs-league">League context</p>
    <div class="chartgrid">
      <div class="chartcard wide">
        <div class="cardhead"><div class="htitle"><h3>League: chance creation vs concession</h3><p class="sub">Every club: xG made vs xG allowed per game. Bottom-right is best; Ipswich in red.</p></div><button class="infobtn" type="button" aria-label="About this chart"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Every club's xG for and against per game this season. Source: Understat league page.</span></button></div>
        <div class="canvas-holder" style="height:340px"><canvas id="c-scatter"></canvas></div><div class="note" id="n-scatter" hidden></div>
      </div>
      <div class="chartcard wide">
        <div class="cardhead"><div class="htitle"><h3>How Ipswich compare</h3><p class="sub">Ipswich's rank out of 20 on each measure: a longer bar is better.</p></div><button class="infobtn" type="button" aria-label="About this chart"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Ipswich's rank out of 20 clubs on xG, xGA, non-penalty xG and pressing (PPDA). Source: Understat league page.</span></button></div>
        <div class="ranks" id="ranks"></div>
        <div class="note" id="n-ranks" hidden></div>
      </div>
      <div class="chartcard wide">
        <div class="cardhead"><div class="htitle"><h3>Team strength profile</h3><p class="sub">FPL's attack, defence and overall ratings (home and away) as a percentile vs the league: the club's stylistic fingerprint.</p></div><button class="infobtn" type="button" aria-label="About this chart"><span aria-hidden="true">i</span><span class="tip" role="tooltip">FPL's own attack/defence/overall strength ratings, shown as a percentile against the other 19 clubs. Source: Fantasy Premier League API.</span></button></div>
        <div class="canvas-holder"><canvas id="c-strength"></canvas></div><div class="note" id="n-strength" hidden></div>
      </div>
      <div class="chartcard wide">
        <div class="cardhead"><div class="htitle"><h3>Fixture difficulty: rest of season</h3><p class="sub">FPL's difficulty rating (1 easy to 5 hard) for every remaining fixture: scan the whole run-in for a tough patch or a kind one.</p></div><button class="infobtn" type="button" aria-label="About this data"><span aria-hidden="true">i</span><span class="tip" role="tooltip">FPL's fixture difficulty rating for every remaining match this season (1 easy to 5 hard). Source: Fantasy Premier League API.</span></button></div>
        {% if upcoming %}
        <div class="fdr-strip">
          {% for f in upcoming %}
          <div class="fdr-chip">
            <span class="fdr-gw">GW{{ f.event }}</span>
            <span class="fdr fdr-{{ f.difficulty or 3 }}" title="Fixture difficulty {{ f.difficulty }}/5">{{ f.difficulty or '–' }}</span>
            <span class="fdr-opp">{{ f.opponent_short }}{{ ' (H)' if f.home else ' (A)' }}</span>
          </div>
          {% endfor %}
        </div>
        {% else %}<p class="empty-note">No upcoming fixtures scheduled.</p>{% endif %}
      </div>
      <div class="chartcard wide">
        <div class="cardhead"><div class="htitle"><h3>Top scorers &amp; assists</h3><p class="sub">Every club, ranked by Understat goals and assists this season. Ipswich players highlighted.</p></div><button class="infobtn" type="button" aria-label="About this data"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Every club's leading scorers and assist-makers this season. Source: Understat league page.</span></button></div>
        <div class="cols2">
          <div>
            <h4 class="subhead">Top scorers</h4>
            {% if top_scorers %}
            <table class="rivaltable">
              <thead><tr><th>#</th><th>Player</th><th>Gls</th><th>xG</th></tr></thead>
              <tbody>
                {% for p in top_scorers %}
                <tr class="{{ 'ips' if p.is_ipswich }}">
                  <td>{{ p.rank }}</td>
                  <td class="tm">{% if p.badge %}<img class="badge" src="{{ p.badge }}" alt="">{% endif %}{{ p.player }} <span class="assist">{{ p.team_short }}</span></td>
                  <td><b>{{ p.goals }}</b></td>
                  <td>{{ '%.1f'|format(p.xg) }}</td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
            {% else %}<p class="empty-note">No scorer data yet.</p>{% endif %}
          </div>
          <div>
            <h4 class="subhead">Top assists</h4>
            {% if top_assists %}
            <table class="rivaltable">
              <thead><tr><th>#</th><th>Player</th><th>Ast</th><th>xA</th></tr></thead>
              <tbody>
                {% for p in top_assists %}
                <tr class="{{ 'ips' if p.is_ipswich }}">
                  <td>{{ p.rank }}</td>
                  <td class="tm">{% if p.badge %}<img class="badge" src="{{ p.badge }}" alt="">{% endif %}{{ p.player }} <span class="assist">{{ p.team_short }}</span></td>
                  <td><b>{{ p.assists }}</b></td>
                  <td>{{ '%.1f'|format(p.xa) }}</td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
            {% else %}<p class="empty-note">No assist data yet.</p>{% endif %}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SQUAD -->
  {% endif %}
  {% if page == 'matches' %}
  <section class="panel">
    <div class="block card">
    <div class="cardhead"><h3>Results &amp; reports</h3><button class="infobtn" type="button" aria-label="About this data"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Every match played this season, with xG from Understat. Source: Fantasy Premier League API and Understat.</span></button></div>
    {% if match_pages %}
    <div class="tablewrap">
      <table class="ltable">
        <thead><tr><th>Date</th><th class="tm">Opponent</th><th>Result</th><th>Score</th><th>xG</th></tr></thead>
        <tbody>
          {% for m in match_pages %}
          <tr>
            <td>{{ m.date }}</td>
            <td class="tm">{% if m.opponent_badge %}<img class="badge" src="{{ m.opponent_badge }}" alt="">{% endif %}<a class="playerlink" href="match/{{ m.id }}.html">{{ m.opponent }}</a> <span class="ha">{{ '(H)' if m.home else '(A)' }}</span></td>
            <td><span class="res {{ m.result }}">{{ m.result }}</span></td>
            <td><b>{{ m.gf }}–{{ m.ga }}</b></td>
            <td>{% if m.xg_for is not none %}{{ '%.1f'|format(m.xg_for) }}-{{ '%.1f'|format(m.xg_against) }}{% else %}-{% endif %}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% else %}<p class="empty-note">No matches played yet. The season opens on 22 August.</p>{% endif %}
    </div>
  </section>
  {% endif %}
  {% if page == 'squad' %}
  <section class="panel">
    <div class="block card">
    <div class="cardhead"><h3>Squad · {{ squad|length }} players</h3><button class="infobtn" type="button" aria-label="About this data"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Season totals for every registered player. Source: Fantasy Premier League API.</span></button></div>
    <div class="toolbar">
      <label class="toggle"><input type="checkbox" id="per90-toggle" aria-label="Show per 90 minutes"> Per 90 minutes</label>
    </div>
    <div class="tablewrap">
      <table id="squad">
        <thead><tr>
          <th class="player" aria-sort="none"><button>Player</button></th>
          <th class="pos" aria-sort="none"><button>Pos</button></th>
          <th aria-sort="none"><button>Mins</button></th>
          <th aria-sort="none"><button>G</button></th>
          <th aria-sort="none"><button>A</button></th>
          <th aria-sort="none"><button>xG</button></th>
          <th aria-sort="none"><button>xA</button></th>
          <th aria-sort="none"><button>xGI</button></th>
        </tr></thead>
        <tbody>
          {% for p in squad %}
          <tr data-min="{{ p.minutes }}">
            <td class="player" title="{{ p.full_name }}">{% if p.slug %}<a class="playerlink" href="player/{{ p.slug }}.html">{{ p.name }}</a>{% else %}{{ p.name }}{% endif %}</td>
            <td class="pos"><span class="pill p-{{ p.pos }}">{{ p.pos }}</span></td>
            <td>{{ p.minutes }}</td>
            <td class="per90" data-raw="{{ p.goals }}" data-dec="0">{{ p.goals }}</td>
            <td class="per90" data-raw="{{ p.assists }}" data-dec="0">{{ p.assists }}</td>
            <td class="per90" data-raw="{{ p.xg }}" data-dec="2">{{ '%.2f'|format(p.xg) }}</td>
            <td class="per90" data-raw="{{ p.xa }}" data-dec="2">{{ '%.2f'|format(p.xa) }}</td>
            <td class="per90" data-raw="{{ p.xgi }}" data-dec="2">{{ '%.2f'|format(p.xgi) }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    </div>

    <div class="block card" style="margin-top:30px">
      <div class="cardhead"><h3>Player profiles</h3><button class="infobtn" type="button" aria-label="About this data"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Per-90 stats converted to percentile ranks against positional peers league-wide. Source: Understat league page.</span></button></div>
      <div class="chartcard wide">
        <p class="sub">Per-90 percentile ranks vs positional peers across the Premier League. Search an Ipswich player, then any PL player to compare across the league.</p>
        <div class="profile-controls">
          <label>Ipswich player
            <input id="prof-a" list="prof-a-list" placeholder="Search Ipswich players…" autocomplete="off" spellcheck="false">
            <datalist id="prof-a-list"></datalist>
          </label>
          <label>Compare with (any PL player)
            <input id="prof-b" list="prof-b-list" placeholder="Search all Premier League players…" autocomplete="off" spellcheck="false">
            <datalist id="prof-b-list"></datalist>
          </label>
        </div>
        <div class="canvas-holder" style="height:360px"><canvas id="c-radar"></canvas></div>
        <div class="note" id="n-radar" hidden></div>
      </div>
    </div>
  </section>

  <!-- NEWS -->
  {% endif %}
  {% if page == 'news' %}
  <section class="panel">
    <div class="block card">
    <div class="cardhead"><h3>Latest news</h3><button class="infobtn" type="button" aria-label="About this data"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Headlines merged from Ipswich-specific RSS feeds, newest first. Source: BBC Sport, TWTD and Vital RSS feeds.</span></button></div>
    {% if news %}
    <div class="card">
      <ul class="list newslist">
        {% for a in news %}
        <li>
          {% if a.image %}<img class="thumb" src="{{ a.image|e }}" alt="" loading="lazy">{% endif %}
          <div class="body">
            <div class="meta"><span class="src">{{ a.source|e }}</span>{% if a.date_display %}<span class="date">{{ a.date_display|e }}</span>{% endif %}</div>
            <a class="headline" href="{{ a.link|e }}" target="_blank" rel="noopener noreferrer">{{ a.title|e }}</a>
            {% if a.summary %}<p class="summary">{{ a.summary|e }}</p>{% endif %}
          </div>
        </li>
        {% endfor %}
      </ul>
    </div>
    <p class="empty-note" style="padding:14px 2px 0">Headlines from Ipswich-focused RSS feeds. Links open on the publisher's site.</p>
    {% else %}<p class="empty-note">No news available right now.</p>{% endif %}
    </div>
  </section>
{% endif %}
</main>

<footer class="wrap">
  {% if health and health.missing %}<div class="health-note" role="status">⚠ Some data sources returned nothing on the last update: {{ health.missing|join(', ') }}. Those sections may be incomplete until the next successful rebuild.</div>{% endif %}
  Data from the FPL API (squad &amp; team news), Understat (xG &amp; shots), ESPN (table), TheSportsDB (badges), football-data.co.uk (head-to-head), ClubElo (win probability) and Ipswich RSS feeds (news) · rebuilt automatically via GitHub Actions.<br>
  Raw data: <code>data/itfc.json</code> · A reference page, not affiliated with Ipswich Town FC.
</footer>

{% if page in ['charts','squad'] %}
<script id="itfc-data" type="application/json">{{ data_json|safe }}</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
{% endif %}
<script>
(function(){
  var _d = document.getElementById('itfc-data');
  var DATA = _d ? JSON.parse(_d.textContent) : {};
  // Drop any news thumbnail whose image fails to load (dead/hotlink-blocked URL).
  [].forEach.call(document.querySelectorAll('.newslist .thumb'), function(img){
    img.addEventListener('error', function(){ img.remove(); });
  });
  // Give each chart canvas a text alternative for screen readers.
  [].forEach.call(document.querySelectorAll('canvas'), function(c){
    var card = c.closest('.chartcard') || c.closest('.card'); if(!card) return;
    var h = card.querySelector('h3'), s = card.querySelector('.sub, .empty-note');
    c.setAttribute('role','img');
    c.setAttribute('aria-label', (h?h.textContent:'Chart') + (s?'. '+s.textContent:''));
  });
  // Club badges come from the PL's full-colour set; hide (rather than show a broken
  // "?") on the rare chance one fails to load.
  [].forEach.call(document.querySelectorAll('img'), function(img){
    if(img.src.indexOf('resources.premierleague.com') === -1) return;
    img.addEventListener('error', function(){ img.style.visibility = 'hidden'; });
  });
  // Charts page: keep the section jump-nav pinned directly under the tabs bar
  // (heights vary by theme/viewport, so measure rather than hard-code), and
  // highlight whichever section is currently under the sticky bars.
  var jump = document.querySelector('.chartjump');
  if(jump){
    var tabsEl = document.querySelector('.tabs');
    var root = document.documentElement;
    function syncStickyOffsets(){
      root.style.setProperty('--tabs-h', (tabsEl ? tabsEl.getBoundingClientRect().height : 0)+'px');
      root.style.setProperty('--jump-h', jump.getBoundingClientRect().height+'px');
    }
    var links = [].slice.call(jump.querySelectorAll('a'));
    var sections = links.map(function(a){ return document.querySelector(a.getAttribute('href')); });
    function syncActive(){
      var offset = jump.getBoundingClientRect().bottom + 8;
      var current = sections[0];
      sections.forEach(function(sec){ if(sec && sec.getBoundingClientRect().top - offset <= 1) current = sec; });
      links.forEach(function(a, i){ a.classList.toggle('active', sections[i] === current); });
    }
    // Only show the bar's background once it's actually pinned under the tabs
    // (its sticky "top" position), not while it's still scrolling with the page.
    function syncStuck(){
      var tabsH = tabsEl ? tabsEl.getBoundingClientRect().height : 0;
      jump.classList.toggle('stuck', jump.getBoundingClientRect().top <= tabsH + 0.5);
    }
    var ticking = false;
    function onScroll(){
      if(ticking) return; ticking = true;
      requestAnimationFrame(function(){ syncActive(); syncStuck(); ticking = false; });
    }
    syncStickyOffsets(); syncActive(); syncStuck();
    window.addEventListener('scroll', onScroll, {passive:true});
    window.addEventListener('resize', function(){ syncStickyOffsets(); syncActive(); syncStuck(); });
  }

  var css = getComputedStyle(document.documentElement);
  function cv(n){ return css.getPropertyValue(n).trim(); }
  var C = {blue:cv('--primary'),red:cv('--loss'),amber:cv('--brand-orange'),green:cv('--win'),muted:cv('--stone'),line:cv('--chart-grid'),pitch:cv('--tint-mint'),pitchline:cv('--hairline-strong')};
  var SHOT = {Goal:cv('--win'),SavedShot:cv('--link-blue'),BlockedShot:cv('--brand-orange'),MissedShots:cv('--stone'),ShotOnPost:cv('--loss'),OwnGoal:cv('--stone')};

  // Each section is its own page now — build whatever this page contains.
  if(document.getElementById('c-points')) buildCharts();
  if(document.getElementById('c-radar')) buildProfiles();

  function showNote(id,msg){ var c=document.getElementById('c-'+id); if(c)c.style.display='none';
    var n=document.getElementById('n-'+id); if(n){n.hidden=false;n.textContent=msg;} }
  function baseOpts(extra){
    var o={responsive:true,maintainAspectRatio:false,
      plugins:{legend:{labels:{boxWidth:12,font:{size:12}}}},
      scales:{x:{grid:{color:C.line},ticks:{font:{size:11}}},
              y:{grid:{color:C.line},ticks:{font:{size:11}},beginAtZero:true}}};
    return Object.assign(o, extra||{});
  }
  // Line charts get a line-shaped legend key instead of the default square, dashed
  // to match a dashed series, so the key reads as a miniature of the series it labels.
  // usePointStyle resolves per-point (not per-line) options, which drops borderDash,
  // so the dash pattern is read straight off the dataset instead of Chart.js's default.
  function lineLabels(chart){
    return chart.data.datasets.map(function(d,i){
      var meta = chart.getDatasetMeta(i);
      return {text:d.label, fillStyle:'transparent', strokeStyle:d.borderColor,
        lineWidth:2, lineDash:d.borderDash||[], pointStyle:'line',
        hidden:!meta.visible, datasetIndex:i};
    });
  }
  function lineOpts(extra){
    return baseOpts(Object.assign({plugins:{legend:{labels:
      {boxWidth:12,font:{size:12},usePointStyle:true,generateLabels:lineLabels}}}}, extra||{}));
  }

  function buildCharts(){
    if(!window.Chart){ ['points','xpts','goals','xg','xga','xgd','xgvs','ppda','deep','homeaway','shots','situation','setpiece','finish','elo','timing','gamestate','discipline','strength'].forEach(function(id){showNote(id,'Charts library did not load.');}); }
    else {
      Chart.defaults.font.family="Inter, system-ui, sans-serif"; Chart.defaults.color=C.muted;
      var gw = DATA.by_gameweek||[], labels = gw.map(function(d){return 'GW'+d.gw;});

      // Points progression across the whole season: actual so far, projected to GW38
      // at current points-per-game, vs the pace the 17th-placed team is on (survival).
      var TOTAL_GW = 38;
      var seasonLabels = []; for(var _g=1;_g<=TOTAL_GW;_g++) seasonLabels.push('GW'+_g);
      if(gw.length){
        var played = gw.length;
        var cumPts = gw.map(function(d){return d.cum_points;});
        var lastPts = cumPts[played-1], ppg = lastPts/played;
        var actualData = seasonLabels.map(function(_,i){return i < played ? cumPts[i] : null;});
        var projData = seasonLabels.map(function(_,i){var g=i+1;
          if(g < played) return null;
          if(g === played) return lastPts;
          return +(lastPts + ppg*(g-played)).toFixed(1);});
        var tbl = DATA.table||[], safe=null;
        for(var _k=0;_k<tbl.length;_k++){ if(tbl[_k].rank===17){safe=tbl[_k];break;} }
        if(!safe && tbl.length>=17) safe = tbl[16];
        var dsets=[
          {label:'Points',data:actualData,borderColor:C.blue,backgroundColor:'rgba(22,52,107,.10)',fill:true,tension:.2,pointRadius:3,spanGaps:false},
          {label:'Projected ('+Math.round(ppg*TOTAL_GW)+' pts)',data:projData,borderColor:C.blue,borderDash:[6,5],tension:.2,pointRadius:0,fill:false}];
        if(safe && safe.played){
          var sp = safe.points/safe.played, survFinal=Math.round(sp*TOTAL_GW);
          dsets.push({label:'Survival pace (~'+survFinal+' pts)',
            data:seasonLabels.map(function(_,i){return +(sp*(i+1)).toFixed(1);}),
            borderColor:C.red,borderDash:[3,4],tension:0,pointRadius:0,fill:false});
        }
        new Chart(document.getElementById('c-points'),{type:'line',
          data:{labels:seasonLabels,datasets:dsets},
          options:lineOpts({scales:{x:{grid:{display:false},ticks:{maxTicksLimit:13}},
            y:{beginAtZero:true,grid:{color:C.line}}}})});
      } else showNote('points','No matches played yet.');

      if(gw.length){ new Chart(document.getElementById('c-goals'),{type:'bar',
        data:{labels:labels,datasets:[
          {label:'For',data:gw.map(function(d){return d.gf;}),backgroundColor:C.blue},
          {label:'Against',data:gw.map(function(d){return d.ga;}),backgroundColor:C.red}]},
        options:baseOpts()}); } else showNote('goals','No matches played yet.');

      // Understat match xG (fallback to FPL by_gameweek team_xg)
      var um = DATA.understat_matches||[];
      function cumFrom(arr,key){var t=0;return arr.map(function(d){t+=(d[key]||0);return +t.toFixed(2);});}
      var xgLabels, gForCum, xgForCum, gAgCum, xgAgCum;
      if(um.length){
        xgLabels = um.map(function(m,i){return 'M'+(i+1);});
        gForCum=cumFrom(um,'gf'); xgForCum=cumFrom(um,'xg_for');
        gAgCum=cumFrom(um,'ga'); xgAgCum=cumFrom(um,'xg_against');
      } else if(gw.length){
        xgLabels=labels; gForCum=cumFrom(gw,'gf'); xgForCum=cumFrom(gw,'team_xg');
        gAgCum=cumFrom(gw,'ga'); xgAgCum=cumFrom(gw,'team_xga');
      }
      if(xgLabels){ new Chart(document.getElementById('c-xg'),{type:'line',
        data:{labels:xgLabels,datasets:[
          {label:'Goals',data:gForCum,borderColor:C.blue,tension:.25,pointRadius:2},
          {label:'xG',data:xgForCum,borderColor:C.amber,borderDash:[6,4],tension:.25,pointRadius:2}]},
        options:lineOpts()}); } else showNote('xg','No matches played yet.');

      if(xgLabels){ new Chart(document.getElementById('c-xga'),{type:'line',
        data:{labels:xgLabels,datasets:[
          {label:'Conceded',data:gAgCum,borderColor:C.red,tension:.25,pointRadius:2},
          {label:'xG against',data:xgAgCum,borderColor:C.muted,borderDash:[6,4],tension:.25,pointRadius:2}]},
        options:lineOpts()}); } else showNote('xga','No matches played yet.');

      // Rolling xG difference (5-match average of xG for minus xG against)
      var WIN = 5;
      if(um.length){
        var diff = um.map(function(m){return (m.xg_for||0)-(m.xg_against||0);});
        var roll = diff.map(function(_,i){var s=Math.max(0,i-WIN+1),seg=diff.slice(s,i+1);
          return +(seg.reduce(function(a,b){return a+b;},0)/seg.length).toFixed(2);});
        new Chart(document.getElementById('c-xgd'),{type:'line',
          data:{labels:um.map(function(m,i){return 'M'+(i+1);}),datasets:[
            {label:'Rolling xGD',data:roll,borderColor:C.blue,backgroundColor:'rgba(22,52,107,.12)',
              fill:'origin',tension:.3,pointRadius:2}]},
          options:baseOpts({plugins:{legend:{display:false}},
            scales:{x:{grid:{display:false}},y:{grid:{color:C.line},
              title:{display:true,text:'xG diff / game (5-match avg)'}}}})});
      } else showNote('xgd','No match xG data yet.');

      // xG for vs xG against, match by match, with each side's season average
      // as a flat dashed reference line — a quick read on whether a given
      // match was an outlier or close to the norm.
      var xgFinished = um.filter(function(m){return m.xg_for!=null && m.xg_against!=null;});
      if(xgFinished.length){
        var avgXgFor = xgFinished.reduce(function(a,m){return a+m.xg_for;},0)/xgFinished.length;
        var avgXgAgainst = xgFinished.reduce(function(a,m){return a+m.xg_against;},0)/xgFinished.length;
        new Chart(document.getElementById('c-xgvs'),{type:'bar',
          data:{labels:xgFinished.map(function(m,i){return 'M'+(i+1);}),datasets:[
            {label:'xG for',data:xgFinished.map(function(m){return m.xg_for;}),backgroundColor:C.blue,order:1},
            {label:'xG against',data:xgFinished.map(function(m){return m.xg_against;}),backgroundColor:C.red,order:1},
            {type:'line',label:'Season avg for ('+avgXgFor.toFixed(2)+')',
              data:xgFinished.map(function(){return avgXgFor;}),borderColor:C.blue,borderDash:[6,4],
              pointRadius:0,fill:false,tension:0,order:0},
            {type:'line',label:'Season avg against ('+avgXgAgainst.toFixed(2)+')',
              data:xgFinished.map(function(){return avgXgAgainst;}),borderColor:C.red,borderDash:[6,4],
              pointRadius:0,fill:false,tension:0,order:0}]},
          options:baseOpts({scales:{x:{grid:{display:false}},
            y:{beginAtZero:true,grid:{color:C.line},title:{display:true,text:'xG'}}}})});
      } else showNote('xgvs','No match xG data yet.');

      // Home / away split — per-game points, goals and xG by venue (from Understat matches)
      var hm = DATA.understat_matches||[];
      if(hm.length){
        function agg(isHome){var m=hm.filter(function(x){return !!x.home===isHome;});
          if(!m.length) return null; var n=m.length,gf=0,ga=0,xf=0,xa=0,pts=0;
          m.forEach(function(x){gf+=x.gf||0;ga+=x.ga||0;xf+=x.xg_for||0;xa+=x.xg_against||0;
            pts+=(x.gf>x.ga?3:(x.gf===x.ga?1:0));});
          return [pts/n,gf/n,ga/n,xf/n,xa/n].map(function(v){return +v.toFixed(2);});}
        var H=agg(true),A=agg(false);
        new Chart(document.getElementById('c-homeaway'),{type:'bar',
          data:{labels:['PPG','Goals for','Goals against','xG for','xGA'],datasets:[
            {label:'Home',data:H||[0,0,0,0,0],backgroundColor:C.blue},
            {label:'Away',data:A||[0,0,0,0,0],backgroundColor:C.amber}]},
          options:baseOpts({scales:{x:{grid:{display:false}},y:{beginAtZero:true,grid:{color:C.line}}}})});
      } else showNote('homeaway','No match data yet.');

      // Expected points vs actual (Understat xPts), cumulative
      var uh = DATA.understat_history||[];
      function rollAvg(arr,w){return arr.map(function(_,i){var s=Math.max(0,i-w+1),
        seg=arr.slice(s,i+1).filter(function(v){return v!=null;});
        return seg.length? +(seg.reduce(function(a,b){return a+b;},0)/seg.length).toFixed(2):null;});}
      if(uh.length){
        var cp=0, cx=0;
        new Chart(document.getElementById('c-xpts'),{type:'line',
          data:{labels:uh.map(function(_,i){return 'M'+(i+1);}),datasets:[
            {label:'Points',data:uh.map(function(h){cp+=(h.pts||0);return cp;}),
              borderColor:C.blue,backgroundColor:'rgba(22,52,107,.10)',fill:true,tension:.25,pointRadius:2},
            {label:'Expected points',data:uh.map(function(h){cx+=(h.xpts||0);return +cx.toFixed(1);}),
              borderColor:C.amber,borderDash:[6,4],tension:.25,pointRadius:2}]},
          options:lineOpts()});
      } else showNote('xpts','No match data yet.');

      // Pressing intensity — rolling PPDA (lower = press harder)
      if(uh.length){ new Chart(document.getElementById('c-ppda'),{type:'line',
        data:{labels:uh.map(function(_,i){return 'M'+(i+1);}),datasets:[
          {label:'PPDA (5-game avg)',data:rollAvg(uh.map(function(h){return h.ppda;}),5),
            borderColor:C.blue,tension:.3,pointRadius:2,spanGaps:true}]},
        options:baseOpts({plugins:{legend:{display:false}},scales:{x:{grid:{display:false}},
          y:{grid:{color:C.line},title:{display:true,text:'PPDA (lower = press harder)'}}}})}); }
      else showNote('ppda','No pressing data yet.');

      // Territory — deep completions for vs against
      if(uh.length){ new Chart(document.getElementById('c-deep'),{type:'bar',
        data:{labels:uh.map(function(_,i){return 'M'+(i+1);}),datasets:[
          {label:'For',data:uh.map(function(h){return h.deep;}),backgroundColor:C.blue},
          {label:'Against',data:uh.map(function(h){return h.deep_allowed;}),backgroundColor:C.red}]},
        options:baseOpts({scales:{x:{grid:{display:false}},y:{beginAtZero:true,grid:{color:C.line}}}})}); }
      else showNote('deep','No territory data yet.');

      // Shots for & against, with shots on target (football-data)
      var ms = DATA.match_stats||[];
      if(ms.length){ new Chart(document.getElementById('c-shots'),{type:'bar',
        data:{labels:ms.map(function(m){return (m.opponent||'').slice(0,3).toUpperCase()+(m.home?' (H)':' (A)');}),
          datasets:[
            {label:'Shots for',data:ms.map(function(m){return m.shots_for;}),backgroundColor:C.blue,order:1},
            {label:'Shots against',data:ms.map(function(m){return m.shots_against;}),backgroundColor:C.red,order:1},
            {type:'line',label:'On target (for)',data:ms.map(function(m){return m.sot_for;}),
              borderColor:C.green,backgroundColor:C.green,pointRadius:3,fill:false,tension:.2,order:0}]},
        options:baseOpts({scales:{x:{grid:{display:false}},y:{beginAtZero:true,grid:{color:C.line}}}})}); }
      else showNote('shots','No shot-count data yet.');

      // Where shots come from + set-piece conversion + hardest/easiest chances —
      // one pass over every match's shots for the whole season (not just the last
      // few), sharing the shot/goal counts and per-shot records.
      var sit={}, chanceShots=[];
      (DATA.match_pages||[]).forEach(function(m){(m.shots_for||[]).forEach(function(s){
        var k=s.situation||'Unknown';
        if(!sit[k]) sit[k]={shots:0,goals:0};
        sit[k].shots++;
        if(s.result==='Goal') sit[k].goals++;
        chanceShots.push({player:s.player,xg:s.xg,minute:s.minute,result:s.result,
          mid:m.id,opp:m.opponent,home:m.home});
      });});
      var sk=Object.keys(sit);
      var niceSit={OpenPlay:'Open play',FromCorner:'From corner',SetPiece:'Set piece',DirectFreekick:'Free kick',Penalty:'Penalty'};
      if(sk.length){
        var order=sk.slice().sort(function(a,b){return sit[b].shots-sit[a].shots;});
        new Chart(document.getElementById('c-situation'),{type:'bar',
          data:{labels:order.map(function(k){return niceSit[k]||k;}),datasets:[
            {data:order.map(function(k){return sit[k].shots;}),backgroundColor:C.blue,borderRadius:4}]},
          options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,
            plugins:{legend:{display:false}},
            scales:{x:{beginAtZero:true,grid:{color:C.line},ticks:{precision:0}},y:{grid:{display:false}}}}}); }
      else showNote('situation','No shot-location data yet.');

      if(sk.length){
        var convOrder=sk.slice().sort(function(a,b){return (sit[b].goals/sit[b].shots)-(sit[a].goals/sit[a].shots);});
        new Chart(document.getElementById('c-setpiece'),{type:'bar',
          data:{labels:convOrder.map(function(k){return (niceSit[k]||k)+' ('+sit[k].shots+')';}),datasets:[
            {data:convOrder.map(function(k){return +(sit[k].goals/sit[k].shots*100).toFixed(1);}),
              backgroundColor:C.amber,borderRadius:4}]},
          options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,
            plugins:{legend:{display:false},tooltip:{callbacks:{label:function(ctx){
              var k=convOrder[ctx.dataIndex]; return sit[k].goals+' goals from '+sit[k].shots+' shots ('+ctx.raw+'%)';}}}},
            scales:{x:{beginAtZero:true,grid:{color:C.line},ticks:{callback:function(v){return v+'%';}}},
                    y:{grid:{display:false}}}}}); }
      else showNote('setpiece','No shot-location data yet.');

      // Hardest chances taken (lowest-xG goals) and easiest chances missed
      // (highest-xG non-goals) — season extremes, sharing chanceShots above.
      function chanceRow(s){
        var col=SHOT[s.result]||'#9aa6b8';
        return '<li class="has-link"><a class="rowlink" href="match/'+s.mid+'.html" aria-label="Match report: Ipswich '+
          (s.home?'vs ':'at ')+esc(s.opp)+'"></a>'+
          '<i class="chance-dot" style="background:'+col+'"></i>'+
          '<div class="body"><div class="chance-top"><span class="cl-player">'+esc(s.player)+'</span>'+
          '<span class="cl-xg">'+s.xg.toFixed(2)+' xG</span></div>'+
          '<div class="cl-meta">'+(s.home?'vs ':'at ')+esc(s.opp)+' · '+s.minute+"'</div></div></li>";
      }
      var hardest = chanceShots.filter(function(s){return s.result==='Goal';})
        .sort(function(a,b){return a.xg-b.xg;}).slice(0,5);
      var easiest = chanceShots.filter(function(s){return s.result!=='Goal';})
        .sort(function(a,b){return b.xg-a.xg;}).slice(0,5);
      var hEl=document.getElementById('chances-hardest'), eEl=document.getElementById('chances-easiest');
      if(chanceShots.length){
        hEl.innerHTML = hardest.length ? hardest.map(chanceRow).join('')
          : '<li class="empty-note" style="padding:10px 2px">No goals yet this season.</li>';
        eEl.innerHTML = easiest.length ? easiest.map(chanceRow).join('')
          : '<li class="empty-note" style="padding:10px 2px">No missed chances yet.</li>';
      } else {
        document.getElementById('chances-cols').style.display='none';
        showNote('chances','No shot-location data yet.');
      }

      // Elo trend
      var eh = DATA.elo_history||[];
      if(eh.length>1){ new Chart(document.getElementById('c-elo'),{type:'line',
        data:{labels:eh.map(function(d){return d.date;}),datasets:[
          {label:'Elo',data:eh.map(function(d){return d.elo;}),borderColor:C.blue,
            backgroundColor:'rgba(22,52,107,.10)',fill:true,tension:.25,pointRadius:2}]},
        options:baseOpts({plugins:{legend:{display:false}},scales:{x:{grid:{display:false}},
          y:{grid:{color:C.line},title:{display:true,text:'ClubElo rating'}}}})}); }
      else showNote('elo','No Elo history yet.');

      // Goals by 15-minute phase (from match-page shots)
      var buckets=['0-15','16-30','31-45','46-60','61-75','76-90+'];
      function bkt(mn){var i=Math.floor((mn-1)/15);return Math.max(0,Math.min(5,i));}
      var gFor=[0,0,0,0,0,0], gAg=[0,0,0,0,0,0], anyGoal=false;
      (DATA.match_pages||[]).forEach(function(m){
        (m.shots_for||[]).forEach(function(s){if(s.result==='Goal'){gFor[bkt(s.minute)]++;anyGoal=true;}});
        (m.shots_against||[]).forEach(function(s){if(s.result==='Goal'){gAg[bkt(s.minute)]++;anyGoal=true;}});
      });
      if(anyGoal){ new Chart(document.getElementById('c-timing'),{type:'bar',
        data:{labels:buckets,datasets:[
          {label:'Scored',data:gFor,backgroundColor:C.green},
          {label:'Conceded',data:gAg,backgroundColor:C.red}]},
        options:baseOpts({scales:{x:{grid:{display:false}},y:{beginAtZero:true,grid:{color:C.line},ticks:{precision:0}}}})}); }
      else showNote('timing','No goal-timing data yet.');

      // Points by half-time state — from match_pages (always populated once
      // Understat has the match) rather than match_stats, so this doesn't
      // depend on ESPN/football-data having shot-level detail for the match.
      var mpg = DATA.match_pages||[];
      if(mpg.length){
        var st={ahead:[0,0],level:[0,0],behind:[0,0]};  // [points, games]
        mpg.forEach(function(m){var s=m.ht_state; if(!st[s])return;
          st[s][0]+=(m.result==='W'?3:m.result==='D'?1:0); st[s][1]++;});
        var order=['ahead','level','behind'], lab={ahead:'Leading at HT',level:'Level at HT',behind:'Behind at HT'};
        new Chart(document.getElementById('c-gamestate'),{type:'bar',
          data:{labels:order.map(function(k){return lab[k];}),datasets:[{label:'Points per game',
            data:order.map(function(k){return st[k][1]? +(st[k][0]/st[k][1]).toFixed(2):0;}),
            backgroundColor:[C.green,C.muted,C.red]}]},
          options:baseOpts({plugins:{legend:{display:false}},scales:{x:{grid:{display:false}},y:{beginAtZero:true,max:3,grid:{color:C.line}}}})});
      } else showNote('gamestate','No half-time data yet.');

      // Discipline: fouls & cards per game, for vs against
      if(ms.length){var n=ms.length;
        function avg(k){return +(ms.reduce(function(a,m){return a+(m[k]||0);},0)/n).toFixed(2);}
        new Chart(document.getElementById('c-discipline'),{type:'bar',
          data:{labels:['Fouls','Yellows','Reds'],datasets:[
            {label:'The club',data:[avg('fouls_for'),avg('yellows_for'),avg('reds_for')],backgroundColor:C.blue},
            {label:'Opponents',data:[avg('fouls_against'),avg('yellows_against'),avg('reds_against')],backgroundColor:C.red}]},
          options:baseOpts({scales:{x:{grid:{display:false}},y:{beginAtZero:true,grid:{color:C.line}}}})});
      } else showNote('discipline','No discipline data yet.');

      // Team strength radar (percentile vs league)
      var ts=DATA.team_strength||[];
      if(ts.length){ new Chart(document.getElementById('c-strength'),{type:'radar',
        data:{labels:ts.map(function(t){return t.label;}),datasets:[{label:'Percentile vs league',
          data:ts.map(function(t){return t.pct;}),borderColor:C.blue,backgroundColor:C.blue+'33',
          pointBackgroundColor:C.blue,borderWidth:2}]},
        options:{responsive:true,maintainAspectRatio:false,
          scales:{r:{min:0,max:100,ticks:{stepSize:20,backdropColor:'transparent',font:{size:9}},grid:{color:C.line},angleLines:{color:C.line},pointLabels:{font:{size:11}}}},
          plugins:{legend:{display:false},tooltip:{callbacks:{label:function(ctx){return ord(ctx.raw)+' percentile';}}}}}}); }
      else showNote('strength','No strength ratings yet.');

      // Finishing: npg vs npxg scatter with y=x reference
      var pl = (DATA.understat_players||[]).filter(function(p){return p.shots>0;});
      if(pl.length){
        var mx = Math.max.apply(null, pl.map(function(p){return Math.max(p.npg,p.npxg);})).toFixed(1);
        mx = Math.max(1, Math.ceil(mx));
        new Chart(document.getElementById('c-finish'),{type:'scatter',
          data:{datasets:[
            {label:'Players',data:pl.map(function(p){return {x:p.npxg,y:p.npg,name:p.name};}),
              backgroundColor:C.blue,pointRadius:5,pointHoverRadius:7},
            {type:'line',label:'Expected',data:[{x:0,y:0},{x:mx,y:mx}],borderColor:C.muted,
              borderDash:[5,4],pointRadius:0,fill:false}]},
          options:baseOpts({
            plugins:{legend:{display:false},tooltip:{callbacks:{label:function(ctx){
              return ctx.raw.name?(ctx.raw.name+': '+ctx.raw.y+' G, '+ctx.raw.x.toFixed(2)+' npxG'):'';}}}},
            scales:{x:{title:{display:true,text:'npxG'},beginAtZero:true,grid:{color:C.line}},
                    y:{title:{display:true,text:'Goals'},beginAtZero:true,grid:{color:C.line}}}})});
      } else showNote('finish','No shot data yet.');

      // League team scatter: xG vs xGA per game
      var ts = DATA.team_scatter||[];
      if(ts.length){
        var lbl={id:'lbl',afterDatasetsDraw:function(chart){
          var ctx=chart.ctx; ctx.save(); ctx.font='10px Inter, sans-serif';
          chart.data.datasets.forEach(function(ds,di){
            chart.getDatasetMeta(di).data.forEach(function(pt,i){
              var d=ds.data[i]; if(!d||!d.label)return;
              ctx.fillStyle=d.ips?C.red:C.muted; ctx.fillText(d.label, pt.x+5, pt.y+3);
            });
          }); ctx.restore();
        }};
        var pts=ts.map(function(t){return {x:t.xg_pg,y:t.xga_pg,label:t.short,ips:t.is_ipswich};});
        new Chart(document.getElementById('c-scatter'),{type:'scatter',
          data:{datasets:[
            {label:'Clubs',data:pts.filter(function(p){return !p.ips;}),backgroundColor:'#9aa6b8',pointRadius:5},
            {label:'Ipswich',data:pts.filter(function(p){return p.ips;}),backgroundColor:C.red,pointRadius:7}]},
          options:baseOpts({
            plugins:{legend:{display:false},tooltip:{callbacks:{label:function(ctx){
              return ctx.raw.label+': '+ctx.raw.x.toFixed(2)+' xG, '+ctx.raw.y.toFixed(2)+' xGA';}}}},
            scales:{x:{title:{display:true,text:'xG per game'},grid:{color:C.line},beginAtZero:true},
                    y:{title:{display:true,text:'xGA per game'},grid:{color:C.line},beginAtZero:true}}}),
          plugins:[lbl]});
      } else showNote('scatter','No league xG data yet.');

      // League rank bars
      var tr = DATA.team_ranks||[], rc=document.getElementById('ranks');
      if(tr.length && rc){
        rc.innerHTML = tr.map(function(r){
          var frac=(r.total-r.rank+1)/r.total, cls=r.rank<=6?'good':r.rank>=15?'bad':'';
          return '<div class="rankrow"><div class="top"><span>'+r.label+'</span>'+
            '<span><b>'+fmtVal(r.value)+'</b> <span class="pos">'+ord(r.rank)+'/'+r.total+'</span></span></div>'+
            '<div class="rankbar"><span class="'+cls+'" style="width:'+(frac*100).toFixed(0)+'%"></span></div></div>';
        }).join('');
      } else showNote('ranks','League comparison unavailable yet.');
    }
    setupShotMap();
  }

  // Shot map (inline SVG pitch)
  function setupShotMap(){
    var pages = DATA.match_pages||[];
    var sel = document.getElementById('shot-select');
    var scoreEl = document.getElementById('shot-score');
    var holder = document.getElementById('pitch');
    if(!pages.length){ document.querySelector('.shotbar').style.display='none';
      document.querySelector('.shotkey').style.display='none'; showNote('shot','No shot data yet.'); return; }

    var allShots = [];
    pages.forEach(function(m){ (m.shots_for||[]).forEach(function(s){ allShots.push(s); }); });

    var seasonOpt = document.createElement('option');
    seasonOpt.value = 'season';
    seasonOpt.textContent = 'All season (' + allShots.length + ' shots)';
    sel.appendChild(seasonOpt);
    pages.forEach(function(m,i){
      var o=document.createElement('option'); o.value=String(i);
      o.textContent=(m.home?'vs ':'at ')+m.opponent+' · '+m.date; sel.appendChild(o);
    });

    var mr=document.getElementById('match-report');
    function draw(v){
      if(v==='season'){
        sel.value='season';
        scoreEl.textContent = pages.length+' match'+(pages.length===1?'':'es');
        holder.innerHTML = pitchSVG(allShots, true);
        var goals = allShots.filter(function(s){return s.result==='Goal';}).length;
        var totalXg = allShots.reduce(function(a,s){return a+s.xg;},0);
        var top = allShots.slice().sort(function(a,b){return b.xg-a.xg;})[0];
        mr.hidden=false;
        mr.innerHTML='<div class="mr"><span class="k">Shots</span><span class="v">'+allShots.length+'</span></div>'+
          '<div class="mr"><span class="k">Goals</span><span class="v">'+goals+'</span></div>'+
          '<div class="mr"><span class="k">xG</span><span class="v">'+totalXg.toFixed(2)+'</span></div>'+
          (top?'<div class="mr"><span class="k">Top chance</span><span class="v">'+esc(top.player)+' '+top.xg.toFixed(2)+'</span></div>':'');
        return;
      }
      var m=pages[+v]; scoreEl.textContent=(m.home?'H ':'A ')+m.score;
      holder.innerHTML = pitchSVG(m.shots_for||[]);
      if(m.xg_for!=null){
        var topM=(m.shots_for||[]).slice().sort(function(a,b){return b.xg-a.xg;})[0];
        mr.hidden=false;
        mr.innerHTML='<div class="mr"><span class="k">xG</span><span class="v">'+m.xg_for.toFixed(2)+'–'+m.xg_against.toFixed(2)+'</span></div>'+
          '<div class="mr"><span class="k">Shots</span><span class="v">'+(m.shots_for||[]).length+'</span></div>'+
          (topM?'<div class="mr"><span class="k">Top chance</span><span class="v">'+esc(topM.player)+' '+topM.xg.toFixed(2)+'</span></div>':'');
      } else mr.hidden=true;
    }
    sel.addEventListener('change', function(){ draw(sel.value); });
    draw('season');
  }
  function pitchSVG(shots, dense){
    var W=105,H=68, g=C.pitch, ln=C.pitchline;
    function box(x,w){return '<rect x="'+x+'" y="'+((H-40)/2)+'" width="'+w+'" height="40" fill="none" stroke="'+ln+'" stroke-width="0.4"/>';}
    var s='<svg viewBox="-2 -2 '+(W+4)+' '+(H+4)+'" xmlns="http://www.w3.org/2000/svg">';
    s+='<rect x="0" y="0" width="'+W+'" height="'+H+'" fill="'+g+'" stroke="'+ln+'" stroke-width="0.5"/>';
    s+='<line x1="'+(W/2)+'" y1="0" x2="'+(W/2)+'" y2="'+H+'" stroke="'+ln+'" stroke-width="0.4"/>';
    s+='<circle cx="'+(W/2)+'" cy="'+(H/2)+'" r="9.15" fill="none" stroke="'+ln+'" stroke-width="0.4"/>';
    s+=box(0,16.5)+box(W-16.5,16.5);
    var op = dense ? 0.35 : 0.78;
    var rBase = dense ? 1.4 : 2, rScale = dense ? 4.5 : 7;
    shots.forEach(function(sh){
      var cx=sh.x*W, cy=sh.y*H, r=rBase+Math.sqrt(sh.xg)*rScale;
      var col=SHOT[sh.result]||'#9aa6b8';
      s+='<circle cx="'+cx.toFixed(1)+'" cy="'+cy.toFixed(1)+'" r="'+r.toFixed(1)+'" fill="'+col+'" fill-opacity="'+op+'" stroke="#0f1826" stroke-opacity="0.2" stroke-width="0.25">'+
         '<title>'+esc(sh.player)+" · "+sh.minute+"' · xG "+sh.xg.toFixed(2)+' · '+esc(sh.result)+'</title></circle>';
    });
    s+='</svg>'; return s;
  }
  function esc(t){return String(t).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}

  // click-to-sort tables (squad, underlying-numbers)
  function makeSortable(id){
    var t=document.getElementById(id);
    if(!t) return;
    var heads=t.tHead.rows[0].cells, body=t.tBodies[0];
    function val(row,i){var s=row.cells[i].textContent.trim().replace('%','');var n=parseFloat(s);return isNaN(n)?s.toLowerCase():n;}
    [].forEach.call(heads,function(th,i){
      th.querySelector('button').addEventListener('click',function(){
        var dir=th.getAttribute('aria-sort')==='ascending'?'descending':'ascending';
        [].forEach.call(heads,function(h){h.setAttribute('aria-sort','none');});
        th.setAttribute('aria-sort',dir);
        var rows=[].slice.call(body.rows);
        rows.sort(function(a,b){var x=val(a,i),y=val(b,i);return x<y?(dir==='ascending'?-1:1):x>y?(dir==='ascending'?1:-1):0;});
        rows.forEach(function(r){body.appendChild(r);});
      });
    });
  }
  makeSortable('squad');
  makeSortable('underlying-table');
  // per-90 toggle
  var per90=document.getElementById('per90-toggle');
  if(per90){
    per90.addEventListener('change',function(){
      var on=per90.checked;
      [].forEach.call(document.querySelectorAll('#squad tbody tr'),function(tr){
        var min=+tr.getAttribute('data-min')||0;
        [].forEach.call(tr.querySelectorAll('td.per90'),function(td){
          var raw=+td.getAttribute('data-raw'), dec=+td.getAttribute('data-dec');
          td.textContent = on ? (min>0?(raw/(min/90)).toFixed(2):'–') : raw.toFixed(dec);
        });
      });
    });
  }

  // player profile radar (percentiles vs positional peers)
  function buildProfiles(){
    var profs=DATA.player_profiles||[];
    var a=document.getElementById('prof-a'), b=document.getElementById('prof-b');
    var la=document.getElementById('prof-a-list'), lb=document.getElementById('prof-b-list');
    if(!profs.length){ var pc=document.querySelector('.profile-controls'); if(pc)pc.style.display='none';
      showNote('radar','No player minutes yet. Profiles appear once games are played.'); return; }
    if(!window.Chart){ showNote('radar','Charts library did not load.'); return; }
    var M=[['goals','Goals'],['assists','Assists'],['npxg','npxG'],['xa','xA'],
           ['shots','Shots'],['key_passes','Key passes'],['xgchain','xGChain'],['xgbuildup','xGBuildup']];
    // unique display key per player, plus datalist options (Ipswich list vs all-PL list)
    function keyOf(p){return p.name + (p.team ? ' (' + p.team + ')' : '');}
    var byKey={};
    profs.forEach(function(p){ byKey[keyOf(p)]=p; });
    function opt(p){var o=document.createElement('option'); o.value=keyOf(p); o.label=p.pos; return o;}
    profs.forEach(function(p){ if(p.is_ipswich) la.appendChild(opt(p)); lb.appendChild(opt(p)); });

    var chart, curA=null, curB=null;
    function ds(p,c){return {label:p.name,data:M.map(function(m){return p.pct[m[0]];}),
      borderColor:c,backgroundColor:c+'33',pointBackgroundColor:c,borderWidth:2,
      _p90:M.map(function(m){return (p.per90&&p.per90[m[0]]!=null)?p.per90[m[0]]:null;})};}
    function draw(){
      if(!curA && !curB){ return; }
      var sets=[];
      if(curA) sets.push(ds(curA,C.blue));
      if(curB) sets.push(ds(curB,C.red));
      var data={labels:M.map(function(m){return m[1];}),datasets:sets};
      var opts={responsive:true,maintainAspectRatio:false,
        scales:{r:{min:0,max:100,ticks:{stepSize:20,backdropColor:'transparent',font:{size:9}},
          grid:{color:C.line},angleLines:{color:C.line},pointLabels:{font:{size:11}}}},
        plugins:{legend:{position:'bottom',labels:{boxWidth:12}},
          tooltip:{callbacks:{label:function(ctx){var p90=ctx.dataset._p90?ctx.dataset._p90[ctx.dataIndex]:null;
            return ctx.dataset.label+': '+ord(ctx.raw)+' pct'+(p90!=null?' ('+p90+' /90)':'');}}}}};
      if(chart){chart.data=data;chart.update();} else chart=new Chart(document.getElementById('c-radar'),{type:'radar',data:data,options:opts});
    }
    function pick(input,isA){
      var p=byKey[input.value];
      if(p){ if(isA) curA=p; else curB=p; draw(); }
      else if(input.value===''){ if(isA) curA=null; else curB=null; draw(); }
    }
    a.addEventListener('change',function(){pick(a,true);});
    a.addEventListener('input',function(){pick(a,true);});
    b.addEventListener('change',function(){pick(b,false);});
    b.addEventListener('input',function(){pick(b,false);});
    var firstIps=profs.filter(function(p){return p.is_ipswich;})[0];
    if(firstIps){ curA=firstIps; a.value=keyOf(firstIps); draw(); }
    else showNote('radar','No Ipswich player minutes yet.');
  }

  function ord(n){var s=['th','st','nd','rd'],v=n%100;return n+(s[(v-20)%10]||s[v]||s[0]);}
  function fmtVal(v){return (Math.round(v)===v)?v:(+v).toFixed(2);}
})();
</script>
<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
