{# Shared header + nav for every page. nav_prefix is "" for top-level pages and
   "../" for match/player pages so links resolve correctly. #}
<a class="skiplink" href="#main">Skip to content</a>
<header class="masthead{% if preview %} is-preview{% endif %}">
  <div class="wrap">
    <div class="crest">
      <div>
        <div class="eyebrow">Premier League · {{ season }}{% if position %} <span class="pos">{{ position|ordinal }}</span>{% endif %}</div>
        <div class="wordmark">Ipswich Town</div>
      </div>
    </div>
    <div class="headright">
      <div class="themeswitch" role="group" aria-label="Theme">
        <button type="button" class="opt" data-theme-opt="light" onclick="__setTheme('light')">Light</button>
        <button type="button" class="opt" data-theme-opt="dark" onclick="__setTheme('dark')">Dark</button>
        <button type="button" class="opt" data-theme-opt="teletext" onclick="__setTheme('teletext')">Txt</button>
      </div>
      <a class="previewtoggle{% if preview %} on{% endif %}" href="{{ toggle_href }}">{% if preview %}← Live data{% else %}Preview mode{% endif %}</a>
      <div class="updated">Updated<b>{{ generated_at|updated }}</b></div>
    </div>
  </div>
</header>
<script>(function(){var t=document.documentElement.getAttribute('data-theme');
  document.querySelectorAll('.themeswitch .opt').forEach(function(b){
    b.setAttribute('aria-pressed', b.dataset.themeOpt===t ? 'true' : 'false');});})();</script>
{% if preview %}<div class="previewbanner">Preview mode. Every section is showing sample data. <a href="{{ toggle_href }}">Switch back to live data</a></div>{% endif %}

<nav class="tabs">
  <div class="wrap">
    {% for pid, filename, label in pages %}
    <a href="{{ nav_prefix }}{{ filename }}"{% if pid == current %} class="active" aria-current="page"{% endif %}>{{ label }}</a>
    {% endfor %}
  </div>
</nav>
