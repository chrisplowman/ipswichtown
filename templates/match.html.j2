<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Ipswich {{ m.gf }}–{{ m.ga }} {{ m.opponent }} · Match report</title>
{% if canonical %}<link rel="canonical" href="{{ canonical }}">{% endif %}
<meta name="description" content="{{ og_description }}">
<meta property="og:type" content="article">
<meta property="og:title" content="{{ og_title }}">
<meta property="og:description" content="{{ og_description }}">
{% if og_image %}<meta property="og:image" content="{{ og_image }}">{% endif %}
{% if canonical %}<meta property="og:url" content="{{ canonical }}">{% endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title }}">
<meta name="twitter:description" content="{{ og_description }}">
{% if og_image %}<meta name="twitter:image" content="{{ og_image }}">{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --brand-navy:#0a1530;--brand-navy-mid:#1a2a52;--brand-orange:#dd5b00;
  --surface:#f6f5f4;--canvas:#ffffff;--ink:#1d1c1a;--ink-deep:#111;
  --steel:#6b6862;--stone:#9a968f;--slate:#4a4844;
  --primary:#5645d4;--win:#1aae39;--draw:#a4a097;--loss:#e03131;--link-blue:#0075de;
  --hairline:#e9e7e3;--hairline-soft:#f0eeeb;--hairline-strong:#dcd9d4;
  --radius-sm:6px;--radius-md:10px;--radius-lg:16px;--radius-full:999px;
  --shadow-card:0 1px 2px rgba(20,20,20,.04),0 2px 8px rgba(20,20,20,.03);
  --space-lg:28px;--on-dark:#fff;--on-dark-muted:#aeb7cc;--chart-grid:#eeece9;
}
*{box-sizing:border-box}
body{margin:0;font-family:Inter,system-ui,sans-serif;background:var(--surface);color:var(--ink);
  font-variant-numeric:tabular-nums;-webkit-font-smoothing:antialiased}
.wrap{max-width:1040px;margin:0 auto;padding:0 24px}
a{color:inherit}
.masthead{background:var(--brand-navy);color:var(--on-dark)}
.masthead .wrap{display:flex;align-items:center;justify-content:space-between;padding:16px 24px}
.back{display:inline-flex;align-items:center;gap:8px;color:var(--on-dark);text-decoration:none;font-weight:500;font-size:14px}
.back:hover{color:#fff;text-decoration:underline}
.masthead .season{font-size:13px;color:var(--on-dark-muted)}
.tabs{border-bottom:1px solid var(--hairline);background:var(--canvas)}
.tabs .wrap{display:flex;gap:8px;padding:12px 24px;flex-wrap:wrap}
.tabs a{font-weight:500;font-size:14px;color:var(--steel);padding:8px 16px;border-radius:var(--radius-full);border:1px solid var(--hairline);text-decoration:none;line-height:1}
.tabs a:hover{color:var(--ink);background:var(--surface)}
main{padding:34px 0 60px}
.block{margin-bottom:22px}
.label{font-size:12px;font-weight:600;letter-spacing:.6px;text-transform:uppercase;color:var(--steel);
  border-bottom:1px solid var(--hairline);padding-bottom:8px;margin:0 0 14px}
.card{background:var(--canvas);border:1px solid var(--hairline);border-radius:var(--radius-lg);
  box-shadow:var(--shadow-card);padding:18px 20px}
h3{margin:0 0 4px;font-size:15px;font-weight:600}
.cols{display:grid;grid-template-columns:1fr 1fr;gap:22px}
@media(max-width:760px){.cols{grid-template-columns:1fr}}

/* scoreline */
.score-card{background:var(--canvas);color:var(--ink);border:1px solid var(--hairline);box-shadow:var(--shadow-card);border-radius:var(--radius-lg);padding:26px 20px;text-align:center}
.score-row{display:flex;align-items:center;justify-content:center;gap:clamp(16px,5vw,48px)}
.score-row .side{display:flex;flex-direction:column;align-items:center;gap:8px;min-width:120px}
.score-row .side img{width:56px;height:56px;object-fit:contain}
.score-row .side .nm{font-weight:600;font-size:15px}
.score-row .sc{font-size:44px;font-weight:700;letter-spacing:-1px}
.score-card .meta{margin-top:14px;font-size:13px;color:var(--steel)}
.pill{display:inline-block;font-size:11px;font-weight:700;letter-spacing:.5px;padding:4px 10px;border-radius:var(--radius-full);text-transform:uppercase}
.pill.W{background:var(--win);color:#fff}.pill.D{background:var(--draw);color:#fff}.pill.L{background:var(--loss);color:#fff}

/* stat comparison */
.statrow{margin-bottom:12px}
.statrow .top{display:flex;justify-content:space-between;font-size:13px;margin-bottom:5px}
.statrow .top .v{font-weight:600;font-size:15px}
.statrow .top .lab{color:var(--steel);align-self:center}
.bar{display:flex;height:8px;border-radius:6px;overflow:hidden;background:var(--hairline)}
.bar .f{background:var(--primary)}.bar .a{background:var(--loss)}
.legend{display:flex;gap:16px;font-size:12px;color:var(--steel);margin-bottom:14px}
.legend i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:5px;vertical-align:-1px}

/* pitch */
.pitch-holder{width:100%;overflow:hidden}
svg.pitch{width:100%;height:auto;display:block;background:var(--canvas)}
.canvas-holder{position:relative;height:280px}

/* tables */
table{width:100%;border-collapse:collapse;font-size:13px}
th,td{text-align:right;padding:7px 8px;border-bottom:1px solid var(--hairline-soft)}
th:first-child,td:first-child{text-align:left}
thead th{font-size:11px;letter-spacing:.4px;text-transform:uppercase;color:var(--steel);font-weight:600}
tbody tr:last-child td{border-bottom:0}

/* goals + h2h */
ul.plain{list-style:none;margin:0;padding:0}
ul.plain li{display:flex;align-items:center;gap:10px;padding:8px 2px;border-bottom:1px solid var(--hairline-soft);font-size:14px}
ul.plain li:last-child{border-bottom:0}
.min{font-weight:600;color:var(--steel);min-width:38px}
.dot{width:8px;height:8px;border-radius:50%}
.dot.f{background:var(--primary)}.dot.a{background:var(--loss)}
.assist{color:var(--stone);font-size:12px}
.res{font-weight:600;border-radius:var(--radius-sm);padding:2px 7px;font-size:12px;color:#fff}
.res.W{background:var(--win)}.res.D{background:var(--draw)}.res.L{background:var(--loss)}
.odds{display:flex;gap:10px;text-align:center}
.odds .o{flex:1;background:var(--surface);border:1px solid var(--hairline);border-radius:var(--radius-md);padding:12px}
.odds .o .p{font-size:22px;font-weight:700}.odds .o .k{font-size:11px;text-transform:uppercase;letter-spacing:.4px;color:var(--steel);margin-top:2px}
.empty-note{color:var(--steel);font-size:14px;padding:8px 2px}
footer{color:var(--steel);font-size:12px;text-align:center;padding:24px;border-top:1px solid var(--hairline)}
</style>
</head>
<body>
<header class="masthead">
  <div class="wrap">
    <a class="back" href="{{ nav_prefix }}index.html">← Ipswich Town stats</a>
    <span class="season">Premier League · {{ season }}</span>
  </div>
</header>
<nav class="tabs"><div class="wrap">
  {% for pid, filename, label in pages %}<a href="{{ nav_prefix }}{{ filename }}">{{ label }}</a>{% endfor %}
</div></nav>

<main class="wrap">
  <!-- SCORELINE -->
  <div class="block">
    <div class="score-card">
      <div class="score-row">
        <div class="side">{% if m.team_badge %}<img src="{{ m.team_badge }}" alt="">{% endif %}<div class="nm">Ipswich</div></div>
        <div class="sc">{{ m.gf }}<span style="opacity:.5"> – </span>{{ m.ga }}</div>
        <div class="side">{% if m.opponent_badge %}<img src="{{ m.opponent_badge }}" alt="">{% endif %}<div class="nm">{{ m.opponent }}</div></div>
      </div>
      <div class="meta">
        <span class="pill {{ m.result }}">{{ {'W':'Win','D':'Draw','L':'Loss'}[m.result] }}</span>
        &nbsp; {{ 'Home' if m.home else 'Away' }}
        {% if m.ht_score %} · HT {{ m.ht_score }}{% endif %}
        {% if m.date %} · {{ m.date }}{% endif %}
        {% if m.referee %} · Ref: {{ m.referee }}{% endif %}
      </div>
    </div>
  </div>

  <!-- MATCH STATS -->
  <div class="block">
    <p class="label">Match stats</p>
    <div class="card">
      <div class="legend"><span><i style="background:var(--primary)"></i>Ipswich</span><span><i style="background:var(--loss)"></i>{{ m.opponent }}</span></div>
      {% macro statrow(label, a, b, dp=0) %}
        {% set af = (a|float) %}{% set bf = (b|float) %}{% set tot = af + bf %}
        <div class="statrow">
          <div class="top"><span class="v">{{ '%.*f'|format(dp, af) }}</span><span class="lab">{{ label }}</span><span class="v">{{ '%.*f'|format(dp, bf) }}</span></div>
          <div class="bar"><span class="f" style="width:{{ (af/tot*100) if tot else 50 }}%"></span><span class="a" style="width:{{ (bf/tot*100) if tot else 50 }}%"></span></div>
        </div>
      {% endmacro %}
      {% if m.xg_for is not none %}{{ statrow('Expected goals (xG)', m.xg_for, m.xg_against, 2) }}{% endif %}
      {% if m.fbd %}
        {{ statrow('Shots', m.fbd.shots_for, m.fbd.shots_against) }}
        {{ statrow('Shots on target', m.fbd.sot_for, m.fbd.sot_against) }}
        {{ statrow('Corners', m.fbd.corners_for, m.fbd.corners_against) }}
        {{ statrow('Fouls', m.fbd.fouls_for, m.fbd.fouls_against) }}
        {{ statrow('Yellow cards', m.fbd.yellows_for, m.fbd.yellows_against) }}
      {% endif %}
      {% if m.deep is not none %}{{ statrow('Deep completions', m.deep, m.deep_allowed) }}{% endif %}
      {% if m.ppda is not none and m.ppda_allowed is not none %}
        <div class="statrow"><div class="top"><span class="v">{{ '%.1f'|format(m.ppda) }}</span><span class="lab">PPDA (lower = pressing harder)</span><span class="v">{{ '%.1f'|format(m.ppda_allowed) }}</span></div></div>
      {% endif %}
      {% if m.xpts is not none %}<p class="empty-note">Expected points from this performance: <b>{{ '%.2f'|format(m.xpts) }}</b> (took {{ {'W':3,'D':1,'L':0}[m.result] }}).</p>{% endif %}
    </div>
  </div>

  <!-- xG FLOW + SHOT MAP -->
  <div class="block">
    <div class="cols">
      <div class="card">
        <h3>xG race</h3><p class="empty-note" style="padding-top:0">Expected goals accumulating through the match — each step is a shot.</p>
        <div class="canvas-holder"><canvas id="c-flow"></canvas></div><div id="n-flow" class="empty-note" hidden></div>
      </div>
      <div class="card">
        <h3>Shot map</h3><p class="empty-note" style="padding-top:0">Both teams' shots. Circle size = xG; filled = goal. Ipswich attack right.</p>
        <div class="pitch-holder" id="pitch"></div>
      </div>
    </div>
  </div>

  <!-- GOALS + ODDS/H2H -->
  <div class="block">
    <div class="cols">
      <div class="card">
        <h3>Goals</h3>
        {% if m.goals %}
        <ul class="plain">
          {% for g in m.goals %}
          <li><span class="min">{{ g.minute }}'</span><span class="dot {{ 'f' if g.side=='for' else 'a' }}"></span>{{ g.player }}{% if g.assist %}<span class="assist">assist: {{ g.assist }}</span>{% endif %}</li>
          {% endfor %}
        </ul>
        {% else %}<p class="empty-note">No goals in this match.</p>{% endif %}
      </div>
      <div class="card">
        {% if m.odds %}
        <h3>Pre-match odds</h3><p class="empty-note" style="padding-top:0">Bookmakers' implied probability (B365).</p>
        <div class="odds">
          <div class="o"><div class="p">{{ m.odds.win }}%</div><div class="k">Ipswich</div></div>
          <div class="o"><div class="p">{{ m.odds.draw }}%</div><div class="k">Draw</div></div>
          <div class="o"><div class="p">{{ m.odds.opp }}%</div><div class="k">{{ m.opponent_short or m.opponent }}</div></div>
        </div>
        {% endif %}
        {% if m.h2h %}
        <h3 style="margin-top:16px">Recent meetings</h3>
        <ul class="plain">
          {% for h in m.h2h %}
          <li><span class="res {{ h.result }}">{{ h.result }}</span>{{ h.opponent }} <span class="assist">{{ '(H)' if h.home else '(A)' }} {{ h.score }} · {{ h.date }}</span></li>
          {% endfor %}
        </ul>
        {% endif %}
      </div>
    </div>
  </div>

  <!-- PLAYER LINES -->
  <div class="block">
    <p class="label">Player performances</p>
    <div class="cols">
      {% for group, players in [('Ipswich', m.players_for), (m.opponent, m.players_against)] %}
      <div class="card">
        <h3>{{ group }}</h3>
        {% if players %}
        <table>
          <thead><tr><th>Player</th><th>Min</th><th>G</th><th>A</th><th>Sh</th><th>xG</th><th>xA</th><th>KP</th></tr></thead>
          <tbody>
            {% for p in players %}
            <tr><td>{{ p.name }}</td><td>{{ p.minutes }}</td><td>{{ p.goals }}</td><td>{{ p.assists }}</td><td>{{ p.shots }}</td><td>{{ '%.2f'|format(p.xg) }}</td><td>{{ '%.2f'|format(p.xa) }}</td><td>{{ p.key_passes }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
        {% else %}<p class="empty-note">No player data.</p>{% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</main>

<footer>Data from Understat (xG, shots, player lines), football-data.co.uk (shots, cards, odds) and the FPL API · a reference page, not affiliated with Ipswich Town FC.</footer>

<script id="match-data" type="application/json">{{ match_json|safe }}</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>
(function(){
  var M = JSON.parse(document.getElementById('match-data').textContent);
  var css=getComputedStyle(document.documentElement); function cv(n){return css.getPropertyValue(n).trim();}
  var BLUE=cv('--primary'), RED=cv('--loss'), GRID=cv('--chart-grid'), LINE=cv('--hairline-strong'), MINT='#eef6f0';

  // ---- xG race (cumulative xG by minute, stepped) ----
  function flow(shots){ var pts=[{x:0,y:0}],c=0;
    (shots||[]).slice().sort(function(a,b){return a.minute-b.minute;}).forEach(function(s){c+=s.xg;pts.push({x:s.minute,y:+c.toFixed(2)});});
    pts.push({x:95,y:+c.toFixed(2)}); return pts; }
  if(window.Chart){
    new Chart(document.getElementById('c-flow'),{type:'line',
      data:{datasets:[
        {label:'Ipswich',data:flow(M.shots_for),borderColor:BLUE,backgroundColor:'rgba(86,69,212,.08)',stepped:true,fill:true,pointRadius:0,borderWidth:2},
        {label:M.opponent,data:flow(M.shots_against),borderColor:RED,stepped:true,fill:false,pointRadius:0,borderWidth:2}]},
      options:{responsive:true,maintainAspectRatio:false,parsing:false,
        scales:{x:{type:'linear',min:0,max:95,title:{display:true,text:'Minute'},grid:{color:GRID}},
          y:{beginAtZero:true,title:{display:true,text:'Cumulative xG'},grid:{color:GRID}}},
        plugins:{legend:{position:'bottom',labels:{boxWidth:12}}}}});
  } else { document.getElementById('c-flow').style.display='none'; var n=document.getElementById('n-flow'); n.hidden=false; n.textContent='Charts library did not load.'; }

  // ---- shot map (both teams on one pitch) ----
  var W=520,H=340;
  function pitch(){
    var s='<svg role="img" aria-label="Shot map" class="pitch" viewBox="0 0 '+W+' '+H+'">';
    s+='<rect x="1" y="1" width="'+(W-2)+'" height="'+(H-2)+'" fill="'+MINT+'" stroke="'+LINE+'"/>';
    s+='<line x1="'+(W/2)+'" y1="1" x2="'+(W/2)+'" y2="'+(H-1)+'" stroke="'+LINE+'"/>';
    s+='<circle cx="'+(W/2)+'" cy="'+(H/2)+'" r="34" fill="none" stroke="'+LINE+'"/>';
    // boxes
    var bh=H*0.55, by=(H-bh)/2, bw=W*0.16;
    s+='<rect x="1" y="'+by+'" width="'+bw+'" height="'+bh+'" fill="none" stroke="'+LINE+'"/>';
    s+='<rect x="'+(W-1-bw)+'" y="'+by+'" width="'+bw+'" height="'+bh+'" fill="none" stroke="'+LINE+'"/>';
    return s;
  }
  function dots(shots,colour,attackRight){
    var s='';
    (shots||[]).forEach(function(sh){
      // Understat X is along length toward goal; Y across. Ipswich attack right.
      var x = attackRight ? sh.x*W : (1-sh.x)*W;
      var y = sh.y*H;
      var r = 3 + Math.sqrt(sh.xg)*13;
      var goal = sh.result==='Goal';
      s+='<circle cx="'+x.toFixed(1)+'" cy="'+y.toFixed(1)+'" r="'+r.toFixed(1)+'" fill="'+(goal?colour:'none')+'" stroke="'+colour+'" stroke-width="1.6" fill-opacity="'+(goal?0.9:0)+'"><title>'+sh.player+' · '+sh.minute+"' · xG "+sh.xg.toFixed(2)+' · '+sh.result+'</title></circle>';
    });
    return s;
  }
  document.getElementById('pitch').innerHTML =
    pitch() + dots(M.shots_against, RED, false) + dots(M.shots_for, BLUE, true) + '</svg>';
})();
</script>
</body>
</html>
