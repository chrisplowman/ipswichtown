<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Ipswich {{ m.gf }}–{{ m.ga }} {{ m.opponent }} · Match report</title>
{% if canonical %}<link rel="canonical" href="{{ canonical }}">{% endif %}
<meta name="description" content="{{ og_description }}">
<meta property="og:type" content="article">
<meta property="og:title" content="{{ og_title }}">
<meta property="og:description" content="{{ og_description }}">
{% if og_image %}<meta property="og:image" content="{{ og_image }}">{% endif %}
{% if canonical %}<meta property="og:url" content="{{ canonical }}">{% endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title }}">
<meta name="twitter:description" content="{{ og_description }}">
{% if og_image %}<meta name="twitter:image" content="{{ og_image }}">{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ css_href }}">
<script>
(function(){var K='itfc-theme',d=document.documentElement;
 // Only the first page view of a session gets the card rise-in animation;
 // every tab click after that is a full navigation and shouldn't replay it.
 try{if(sessionStorage.getItem('itfc-seen')){d.classList.add('seen');}else{sessionStorage.setItem('itfc-seen','1');}}catch(e){}
 function set(t){d.setAttribute('data-theme',t);}
 try{set(localStorage.getItem(K)||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'));}catch(e){set('light');}
 window.__setTheme=function(t){
   // Charts bake their colours in from CSS vars at build time (see cv() below),
   // so a theme switch needs a fresh load to recolour them correctly rather than
   // patching chart chrome in place — most visible jumping into/out of teletext.
   set(t);try{localStorage.setItem(K,t);}catch(e){}
   location.reload();
 };
})();
</script>
</head>
<body class="page-match">
{% include '_masthead.html.j2' %}

<main class="wrap" id="main" tabindex="-1">
  <!-- SCORELINE -->
  <div class="block">
    <div class="score-card">
      <div class="score-row">
        <div class="side">{% if m.team_badge %}<img src="{{ m.team_badge }}" alt="">{% endif %}<div class="nm">Ipswich</div></div>
        <div class="sc">{{ m.gf }}<span style="opacity:.5"> – </span>{{ m.ga }}</div>
        <div class="side">{% if m.opponent_badge %}<img src="{{ m.opponent_badge }}" alt="">{% endif %}<div class="nm">{{ m.opponent }}</div></div>
      </div>
      <div class="meta">
        <span class="pill {{ m.result }}">{{ {'W':'Win','D':'Draw','L':'Loss'}[m.result] }}</span>
        &nbsp; {{ 'Home' if m.home else 'Away' }}
        {% if m.ht_score %} · HT {{ m.ht_score }}{% endif %}
        {% if m.date %} · {{ m.date }}{% endif %}
        {% if m.attendance %} · Att. {{ '{:,}'.format(m.attendance) }}{% endif %}
        {% if m.referee %} · Referee: {{ m.referee }}{% endif %}
      </div>
    </div>
  </div>

  <!-- MATCH REPORTS -->
  {% if m.reports %}
  <div class="block">
    <div class="card">
      <div class="cardhead"><h3>Match reports</h3><button class="infobtn" type="button" aria-label="About this data"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Links to this match's report on other sites, built from each outlet's own predictable report URL — not a search, so an occasional link may 404 for a match that outlet didn't cover.</span></button></div>
      <ul class="plain">
        {% for r in m.reports %}
        <li><span class="eventtext">{{ r.name }}</span><a class="playerlink" href="{{ r.url }}" target="_blank" rel="noopener">Read report ↗</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  {% endif %}

  <!-- LINEUPS -->
  {% if m.lineups %}
  {% macro lineup_row(p) %}
    <li>
      <span class="min">{{ p.jersey }}</span>
      <span class="eventtext">{{ p.name }}
        {% for c in p.cards|default([]) %}<span class="cardchip {{ c.kind }}" title="{{ c.minute }}"></span>{% endfor %}
        {% if p.goals|default([]) %}<span class="assist">G {{ p.goals|join(', ') }}</span>{% endif %}
        {% if p.sub_off %}<span class="assist">↓ {{ p.sub_off }}</span>{% endif %}
        {% if p.sub_on %}<span class="assist">↑ {{ p.sub_on }}</span>{% endif %}
      </span>
      <span class="assist">{{ p.pos }}</span>
    </li>
  {% endmacro %}
  {% macro pitch_marker(p, color) %}
    {% set cx = (600 - (p.y / 100 * 600))|round(1) %}{% set cy = (p.x / 100 * 400)|round(1) %}
    <g>
      <circle cx="{{ cx }}" cy="{{ cy }}" r="13" fill="{{ color }}" stroke="var(--canvas)" stroke-width="2"/>
      <text x="{{ cx }}" y="{{ cy }}" text-anchor="middle" dominant-baseline="central" font-size="10" font-weight="700" fill="#fff">{{ p.jersey }}</text>
      <text x="{{ cx }}" y="{{ cy + 22 }}" text-anchor="middle" font-size="9" fill="var(--ink)">{{ p.name.split(' ')[-1] }}</text>
      <title>{{ p.name }} ({{ p.pos }})</title>
    </g>
  {% endmacro %}
  <div class="block">
    <p class="label">Lineups</p>
    {% if m.lineups['for'] and m.lineups['against'] %}
    <div class="card">
      <div class="cardhead"><h3>Starting XI</h3><button class="infobtn" type="button" aria-label="About this data"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Both starting elevens on one pitch, grouped by broad role (goalkeeper/defence/midfield/attack) rather than exact tactical position — Ipswich attack rightward, {{ m.opponent }} attack leftward. Hover a shirt for the player's full name. Source: ESPN.</span></button></div>
      <div class="legend"><span><i style="background:var(--primary)"></i>Ipswich{% if m.lineups['for'].formation %} ({{ m.lineups['for'].formation }}){% endif %}</span><span><i style="background:var(--loss)"></i>{{ m.opponent }}{% if m.lineups['against'].formation %} ({{ m.lineups['against'].formation }}){% endif %}</span></div>
      <div class="pitch-holder">
        <svg role="img" aria-label="Starting lineups on a pitch" class="pitch" viewBox="0 0 600 400" xmlns="http://www.w3.org/2000/svg">
          <rect x="1" y="1" width="598" height="398" fill="var(--tint-mint)" stroke="var(--hairline-strong)"/>
          <line x1="300" y1="1" x2="300" y2="399" stroke="var(--hairline-strong)"/>
          <circle cx="300" cy="200" r="40" fill="none" stroke="var(--hairline-strong)"/>
          <rect x="1" y="110" width="80" height="180" fill="none" stroke="var(--hairline-strong)"/>
          <rect x="519" y="110" width="80" height="180" fill="none" stroke="var(--hairline-strong)"/>
          {% for p in m.lineups['for'].starters %}{{ pitch_marker(p, 'var(--primary)') }}{% endfor %}
          {% for p in m.lineups['against'].starters %}{{ pitch_marker(p, 'var(--loss)') }}{% endfor %}
        </svg>
      </div>
    </div>
    {% endif %}
    <div class="cols">
      {% for group, lu in [('Ipswich', m.lineups['for']), (m.opponent, m.lineups['against'])] %}
      {% if lu %}
      <div class="card">
        <div class="cardhead"><h3>{{ group }}{% if lu.formation %} ({{ lu.formation }}){% endif %}</h3><button class="infobtn" type="button" aria-label="About this data"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Starting XI and full bench, with goals, cards and substitution minutes for those who came on. Source: ESPN.</span></button></div>
        <ul class="plain">
          {% for p in lu.starters %}{{ lineup_row(p) }}{% endfor %}
        </ul>
        {% if lu.subs %}
        <p class="empty-note" style="padding-top:0">Substitutes:</p>
        <ul class="plain">
          {% for p in lu.subs %}{{ lineup_row(p) }}{% endfor %}
        </ul>
        {% endif %}
      </div>
      {% endif %}
      {% endfor %}
    </div>
  </div>
  {% endif %}

  <!-- MATCH STATS -->
  <div class="block">
    <p class="label">Match stats</p>
    <div class="card">
      <div class="cardhead"><h3>Match statistics</h3><button class="infobtn" type="button" aria-label="About this data"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Shots, cards, corners, possession, passing, tackles, pressing (PPDA) and Understat's expected points for this match. Source: Understat and ESPN, with football-data.co.uk as a fallback.</span></button></div>
      <div class="legend"><span><i style="background:var(--primary)"></i>Ipswich</span><span><i style="background:var(--loss)"></i>{{ m.opponent }}</span></div>
      {% macro statrow(label, a, b, dp=0) %}
        {% set af = (a|float) %}{% set bf = (b|float) %}{% set tot = af + bf %}
        <div class="statrow">
          <div class="top"><span class="v">{{ '%.*f'|format(dp, af) }}</span><span class="lab">{{ label }}</span><span class="v">{{ '%.*f'|format(dp, bf) }}</span></div>
          <div class="bar"><span class="f" style="width:{{ (af/tot*100) if tot else 50 }}%"></span><span class="a" style="width:{{ (bf/tot*100) if tot else 50 }}%"></span></div>
        </div>
      {% endmacro %}
      {% if m.xg_for is not none %}{{ statrow('Expected goals (xG)', m.xg_for, m.xg_against, 2) }}{% endif %}
      {% if m.fbd %}
        {{ statrow('Shots', m.fbd.shots_for, m.fbd.shots_against) }}
        {{ statrow('Shots on target', m.fbd.sot_for, m.fbd.sot_against) }}
        {{ statrow('Corners', m.fbd.corners_for, m.fbd.corners_against) }}
        {{ statrow('Fouls', m.fbd.fouls_for, m.fbd.fouls_against) }}
        {{ statrow('Yellow cards', m.fbd.yellows_for, m.fbd.yellows_against) }}
      {% endif %}
      {% if m.team_stats %}
        {% if m.team_stats.possession_for is not none %}{{ statrow('Possession %', m.team_stats.possession_for, m.team_stats.possession_against, 1) }}{% endif %}
        {% if m.team_stats.pass_pct_for is not none %}{{ statrow('Pass completion %', m.team_stats.pass_pct_for, m.team_stats.pass_pct_against, 1) }}{% endif %}
        {% if m.team_stats.tackles_for is not none %}{{ statrow('Tackles won', m.team_stats.tackles_for, m.team_stats.tackles_against) }}{% endif %}
        {% if m.team_stats.interceptions_for is not none %}{{ statrow('Interceptions', m.team_stats.interceptions_for, m.team_stats.interceptions_against) }}{% endif %}
      {% endif %}
      {% if m.deep is not none %}{{ statrow('Deep completions', m.deep, m.deep_allowed) }}{% endif %}
      {% if m.ppda is not none and m.ppda_allowed is not none %}
        <div class="statrow"><div class="top"><span class="v">{{ '%.1f'|format(m.ppda) }}</span><span class="lab">PPDA (lower = pressing harder)</span><span class="v">{{ '%.1f'|format(m.ppda_allowed) }}</span></div></div>
      {% endif %}
      {% if m.xpts is not none %}<p class="empty-note">Expected points from this performance: <b>{{ '%.2f'|format(m.xpts) }}</b> (took {{ {'W':3,'D':1,'L':0}[m.result] }}).</p>{% endif %}
    </div>
  </div>

  <!-- xG FLOW + SHOT MAP -->
  <div class="block">
    <div class="cols">
      <div class="card">
        <div class="cardhead"><h3>xG race</h3><button class="infobtn" type="button" aria-label="About this chart"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Cumulative Understat xG for each shot, in the order it happened. Source: Understat.</span></button></div><p class="empty-note" style="padding-top:0">Expected goals accumulating through the match. Each step is a shot.</p>
        <div class="canvas-holder"><canvas id="c-flow"></canvas></div><div id="n-flow" class="empty-note" hidden></div>
      </div>
      <div class="card">
        <div class="cardhead"><h3>Shot map</h3><button class="infobtn" type="button" aria-label="About this chart"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Every shot's location, quality and outcome for both teams in this match. Source: Understat.</span></button></div><p class="empty-note" style="padding-top:0">Both teams' shots. Circle size = xG; filled = goal. Ipswich attack right.</p>
        <div class="pitch-holder" id="pitch"></div>
      </div>
    </div>
  </div>

  <!-- GOALS + H2H -->
  <div class="block">
    <div class="cols">
      <div class="card">
        <div class="cardhead"><h3>Goals</h3><button class="infobtn" type="button" aria-label="About this data"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Goals and assists from this match. Source: Understat player lines.</span></button></div>
        {% if m.goals %}
        <ul class="plain">
          {% for g in m.goals %}
          <li><span class="min">{{ g.minute }}'</span><span class="dot {{ 'f' if g.side=='for' else 'a' }}"></span>{{ g.player }}{% if g.assist %}<span class="assist">assist: {{ g.assist }}</span>{% endif %}</li>
          {% endfor %}
        </ul>
        {% else %}<p class="empty-note">No goals in this match.</p>{% endif %}
      </div>
      <div class="card">
        {% if m.h2h %}
        <div class="cardhead"><h3>Recent meetings</h3><button class="infobtn" type="button" aria-label="About this data"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Results from previous meetings between these two clubs. Source: football-data.co.uk historical results.</span></button></div>
        <ul class="plain">
          {% for h in m.h2h %}
          <li><span class="res {{ h.result }}">{{ h.result }}</span>{{ h.opponent }} <span class="assist">{{ '(H)' if h.home else '(A)' }} {{ h.score }} · {{ h.date }}</span></li>
          {% endfor %}
        </ul>
        {% endif %}
      </div>
    </div>
  </div>

  <!-- CARDS + SUBSTITUTIONS -->
  {% if m.cards is defined or m.subs is defined %}
  <div class="block">
    <div class="cols">
      <div class="card">
        <div class="cardhead"><h3>Cards</h3><button class="infobtn" type="button" aria-label="About this data"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Bookings from this match, in order. Source: ESPN.</span></button></div>
        {% if m.cards %}
        <ul class="plain">
          {% for c in m.cards %}
          <li><span class="min">{{ c.minute }}'</span><span class="dot {{ 'f' if c.side=='for' else 'a' }}"></span><span class="cardchip {{ c.kind }}"></span><span class="eventtext">{{ c.text }}</span></li>
          {% endfor %}
        </ul>
        {% else %}<p class="empty-note">No cards in this match.</p>{% endif %}
      </div>
      <div class="card">
        <div class="cardhead"><h3>Substitutions</h3><button class="infobtn" type="button" aria-label="About this data"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Substitutions from this match, in order. Source: ESPN.</span></button></div>
        {% if m.subs %}
        <ul class="plain">
          {% for s in m.subs %}
          <li><span class="min">{{ s.minute }}'</span><span class="dot {{ 'f' if s.side=='for' else 'a' }}"></span><span class="eventtext">{{ s.text }}</span></li>
          {% endfor %}
        </ul>
        {% else %}<p class="empty-note">No substitutions recorded for this match.</p>{% endif %}
      </div>
    </div>
  </div>
  {% endif %}

  <!-- PLAYER LINES -->
  <div class="block">
    <p class="label">Player performances</p>
    <div class="cols">
      {% for group, players in [('Ipswich', m.players_for), (m.opponent, m.players_against)] %}
      <div class="card">
        <div class="cardhead"><h3>{{ group }}</h3><button class="infobtn" type="button" aria-label="About this data"><span aria-hidden="true">i</span><span class="tip" role="tooltip">Per-player minutes, goals, shots and expected involvement for this match. Source: Understat player lines.</span></button></div>
        {% if players %}
        <table>
          <thead><tr><th>Player</th><th>Min</th><th>G</th><th>A</th><th>Sh</th><th>xG</th><th>xA</th><th>KP</th></tr></thead>
          <tbody>
            {% for p in players %}
            <tr><td>{{ p.name }}</td><td>{{ p.minutes }}</td><td>{{ p.goals }}</td><td>{{ p.assists }}</td><td>{{ p.shots }}</td><td>{{ '%.2f'|format(p.xg) }}</td><td>{{ '%.2f'|format(p.xa) }}</td><td>{{ p.key_passes }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
        {% else %}<p class="empty-note">No player data.</p>{% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</main>

{% if m.espn_data_fetched_at %}<p style="text-align:center;color:var(--steel);font-size:12.5px;padding:0 16px">ESPN data (cards, subs, lineups, stats) last fetched {{ m.espn_data_fetched_at|updated }}.</p>{% endif %}
<footer>Data from Understat (xG, shots, player lines), ESPN (shots, cards, subs) and the FPL API · a reference page, not affiliated with Ipswich Town FC.</footer>

<script id="match-data" type="application/json">{{ match_json|safe }}</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>
(function(){
  var M = JSON.parse(document.getElementById('match-data').textContent);
  var css=getComputedStyle(document.documentElement); function cv(n){return css.getPropertyValue(n).trim();}
  var BLUE=cv('--primary'), RED=cv('--loss'), GRID=cv('--chart-grid'), LINE=cv('--hairline-strong'), MINT=cv('--tint-mint');
  if(window.Chart){Chart.defaults.color=cv('--steel');}

  // ---- xG race (cumulative xG by minute, stepped) ----
  function flow(shots){ var pts=[{x:0,y:0}],c=0;
    (shots||[]).slice().sort(function(a,b){return a.minute-b.minute;}).forEach(function(s){c+=s.xg;pts.push({x:s.minute,y:+c.toFixed(2)});});
    pts.push({x:95,y:+c.toFixed(2)}); return pts; }
  if(window.Chart){
    new Chart(document.getElementById('c-flow'),{type:'line',
      data:{datasets:[
        {label:'Ipswich',data:flow(M.shots_for),borderColor:BLUE,backgroundColor:'rgba(86,69,212,.08)',stepped:true,fill:true,pointRadius:0,borderWidth:2},
        {label:M.opponent,data:flow(M.shots_against),borderColor:RED,stepped:true,fill:false,pointRadius:0,borderWidth:2}]},
      options:{responsive:true,maintainAspectRatio:false,parsing:false,
        scales:{x:{type:'linear',min:0,max:95,title:{display:true,text:'Minute'},grid:{color:GRID}},
          y:{beginAtZero:true,title:{display:true,text:'Cumulative xG'},grid:{color:GRID}}},
        plugins:{legend:{position:'bottom',labels:{boxWidth:12}}}}});
  } else { document.getElementById('c-flow').style.display='none'; var n=document.getElementById('n-flow'); n.hidden=false; n.textContent='Charts library did not load.'; }

  // ---- shot map (both teams on one pitch) ----
  var W=520,H=340;
  function pitch(){
    var s='<svg role="img" aria-label="Shot map" class="pitch" viewBox="0 0 '+W+' '+H+'">';
    s+='<rect x="1" y="1" width="'+(W-2)+'" height="'+(H-2)+'" fill="'+MINT+'" stroke="'+LINE+'"/>';
    s+='<line x1="'+(W/2)+'" y1="1" x2="'+(W/2)+'" y2="'+(H-1)+'" stroke="'+LINE+'"/>';
    s+='<circle cx="'+(W/2)+'" cy="'+(H/2)+'" r="34" fill="none" stroke="'+LINE+'"/>';
    // boxes
    var bh=H*0.55, by=(H-bh)/2, bw=W*0.16;
    s+='<rect x="1" y="'+by+'" width="'+bw+'" height="'+bh+'" fill="none" stroke="'+LINE+'"/>';
    s+='<rect x="'+(W-1-bw)+'" y="'+by+'" width="'+bw+'" height="'+bh+'" fill="none" stroke="'+LINE+'"/>';
    return s;
  }
  function dots(shots,colour,attackRight){
    var s='';
    (shots||[]).forEach(function(sh){
      // Understat X is along length toward goal; Y across. Ipswich attack right.
      var x = attackRight ? sh.x*W : (1-sh.x)*W;
      var y = sh.y*H;
      var r = 3 + Math.sqrt(sh.xg)*13;
      var goal = sh.result==='Goal';
      s+='<circle cx="'+x.toFixed(1)+'" cy="'+y.toFixed(1)+'" r="'+r.toFixed(1)+'" fill="'+(goal?colour:'none')+'" stroke="'+colour+'" stroke-width="1.6" fill-opacity="'+(goal?0.9:0)+'"><title>'+sh.player+' · '+sh.minute+"' · xG "+sh.xg.toFixed(2)+' · '+sh.result+'</title></circle>';
    });
    return s;
  }
  document.getElementById('pitch').innerHTML =
    pitch() + dots(M.shots_against, RED, false) + dots(M.shots_for, BLUE, true) + '</svg>';
})();
</script>
<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
<script src="{{ css_href|replace('style.css','share.js') }}"></script>
</body>
</html>
