 .gitignore                   |  4 +++
 README.md                    | 16 +++++++--
 ingest.py                    |  2 +-
 requirements-dev.txt         |  2 ++
 requirements.txt             |  6 ++--
 templates/index.html.j2      | 10 ++----
 tests/test_build.py          | 44 +++++++++++++++++++++++
 tests/test_ingest.py         | 68 ++++++++++++++++++++++++++++++++++++
 9 files changed, 141 insertions(+), 19 deletions(-)
 create mode 100644 .gitignore
 create mode 100644 requirements-dev.txt
 create mode 100644 tests/test_build.py
 create mode 100644 tests/test_ingest.py

